---
interface Column {
  id: string;
  title: string;
  title_en: string;
  description: string;
}

interface Card {
  id: string;
  slug: string;
  title: string;
  title_en: string;
  column: string;
  summary: string;
  tags: string[];
}

interface Props {
  columns: Column[];
  cards: Card[];
  activeSubcategory?: string;
  activeSlug?: string;
}

const { columns, cards, activeSubcategory = '', activeSlug = '' } = Astro.props;

const cardsByColumn = new Map(
  columns.map((column) => [
    column.id,
    cards
      .filter((card) => card.column === column.id)
      .sort((a, b) => a.id.localeCompare(b.id, 'zh-CN', { numeric: true })),
  ]),
);

---

<nav class="tree-nav" aria-label="AI 核心概念子目录">
  <a class="tree-title" href="/knowledge/ai-core/">AI 核心概念子目录</a>
    {columns.map((column) => {
      const columnCards = cardsByColumn.get(column.id) ?? [];
      const isActiveColumn = activeSubcategory === column.id;
      return (
        <details class="tree-group" open={isActiveColumn}>
          <summary class={isActiveColumn ? 'active' : ''}>
            <a href={`/knowledge/ai-core/${column.id}/`}>
              <span>{column.title}</span>
              <strong>{columnCards.length}</strong>
            </a>
          </summary>
          <ul>
            {columnCards.map((card) => (
              <li>
                <a
                  class={activeSlug === card.slug ? 'active-card' : ''}
                  href={`/knowledge/ai-core/${column.id}/${card.slug}/`}
                >
                  <span class="card-id">{card.id}</span>
                  <span>{card.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
</nav>

<style>
  .tree-title {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 1.24rem;
    font-weight: 700;
    text-decoration: none;
  }

  .tree-nav {
    margin-top: 1.2rem;
  }

  .tree-group {
    border-top: 1px solid rgba(184, 184, 184, 0.62);
    padding: 0.35rem 0;
  }

  .tree-group summary {
    cursor: pointer;
    list-style: none;
  }

  .tree-group summary::-webkit-details-marker {
    display: none;
  }

  .tree-group summary > a {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    padding: 0.55rem 0.35rem;
    border-radius: var(--radius);
    text-decoration: none;
  }

  .tree-group summary > a::before {
    content: "+";
    color: var(--accent);
    font-family: var(--font-mono);
    margin-right: 0.15rem;
  }

  .tree-group[open] summary > a::before {
    content: "-";
  }

  .tree-group summary.active > a {
    background: rgba(192, 48, 48, 0.05);
    color: var(--accent);
  }

  .tree-group strong {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .tree-group ul {
    list-style: none;
    padding: 0.15rem 0 0.45rem 0.8rem;
    margin: 0;
  }

  .tree-group li {
    margin: 0.12rem 0;
  }

  .tree-group li a {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0.35rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius);
    color: var(--ink);
    font-size: 0.88rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .tree-group li a:hover,
  .tree-group li a.active-card {
    background: rgba(26, 26, 26, 0.04);
    color: var(--accent);
  }

  .card-id {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

</style>
