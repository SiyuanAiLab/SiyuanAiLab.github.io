---
const navItems = [
  { href: "/", label: "首页" },
  { href: "/lab/", label: "实验室" },
  { href: "/articles", label: "文章" },
  { href: "/knowledge", label: "知识库" },
  { href: "/about", label: "关于" },
  { href: "/contact", label: "联系" },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="site-title">思远 AI Lab</a>
    <nav class="site-nav">
      {navItems.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
