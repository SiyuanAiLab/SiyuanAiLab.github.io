---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactRoutes = [
  {
    title: "阅读公开内容",
    label: "文章 / AI·外脑",
    desc: "先读公开文章、知识卡片和工作流，了解这套个人 AI 工作方式。",
  },
  {
    title: "关注长期更新",
    label: "公众号",
    desc: "公众号持续发布观察日记、搭建过程和阶段复盘。",
  },
  {
    title: "交流使用反馈",
    label: "个人微信",
    desc: "微信用于围绕公开内容交换想法和使用反馈，不承诺固定回复时间。",
  },
];

const pendingItems = [
  "公开文章和知识内容可以直接浏览。",
  "Skill 与个人操作系统按完成度逐步开放说明。",
  "未完成、未校验或涉及个人数据的内容不会公开。",
];
---

<Layout title="联系" description="联系杨思远，关注公众号「思远AiLab」，添加微信 ysy61879257，了解思行致远更新。">
  <Header />

  <main class="site-main contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="container contact-hero-grid">
        <div>
          <p class="kicker">联系与关注</p>
          <h1 id="contact-title">关注更新，也欢迎交换真实使用反馈。</h1>
          <p class="hero-lede">
            公众号负责发布长文和阶段进展，微信保留个人交流入口。这里仅用于内容发布和个人交流。
          </p>
          <div class="contact-actions">
            <a href="/lab/" class="btn">查看实验室</a>
            <a href="/articles" class="btn btn-outline">先读文章</a>
          </div>
        </div>

        <aside class="contact-card" aria-label="公众号与微信联系方式">
          <img src="/assets/wechat-follow-card-standard.png" alt="思远AiLab 公众号二维码" />
          <div class="contact-lines">
            <p>公众号：思远AiLab</p>
            <p>微信：ysy61879257</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section route-section" aria-labelledby="route-title">
      <div class="container">
          <p class="kicker">入口分流</p>
        <h2 id="route-title" class="section-title">你现在可以从三处继续</h2>
        <div class="route-grid">
          {contactRoutes.map(route => (
            <article class="route-card">
              <p class="meta">{route.label}</p>
              <h3>{route.title}</h3>
              <p>{route.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pending-section" aria-labelledby="pending-title">
      <div class="container pending-panel">
        <div>
          <p class="kicker">公开边界</p>
          <h2 id="pending-title">先把真实过程说明白</h2>
          <p>
            当前公开的是个人实践、开源进度和经过脱敏的示例。没有完成校验的内容，会明确标注状态而不是提供占位入口。
          </p>
        </div>
        <ul class="pending-list">
          {pendingItems.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    overflow: hidden;
  }

  .contact-hero {
    padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 8vw, 88px);
  }

  .contact-hero-grid,
  .pending-panel {
    align-items: center;
    display: grid;
    gap: clamp(28px, 6vw, 76px);
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 1.2rem;
  }

  .contact-hero h1 {
    font-size: clamp(2.25rem, 5.5vw, 4.4rem);
    line-height: 1.1;
    max-width: 820px;
  }

  .hero-lede {
    color: var(--grey);
    font-size: clamp(1.04rem, 1.7vw, 1.22rem);
  }

  .contact-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.5rem;
  }

  .contact-card {
    align-items: center;
    background: rgba(245, 241, 233, 0.8);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(20px, 4vw, 36px);
    text-align: center;
  }

  .contact-card img {
    border: 1px solid var(--lead);
    display: block;
    height: auto;
    width: 100%;
  }

  .contact-lines {
    border-top: 1px solid var(--lead);
    margin-top: 1rem;
    padding-top: 1rem;
    width: 100%;
  }

  .contact-lines p {
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 700;
    margin-bottom: 0.35rem;
    max-width: none;
  }

  .route-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-block);
  }

  .route-card {
    background: rgba(245, 241, 233, 0.78);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    min-height: 230px;
    padding: clamp(20px, 3vw, 30px);
  }

  .route-card:first-child {
    background: var(--ink);
    color: var(--paper);
  }

  .route-card:first-child .meta,
  .route-card:first-child p {
    color: rgba(245, 241, 233, 0.76);
  }

  .route-card h3 {
    margin-top: 2.6rem;
  }

  .route-card p:last-child {
    color: var(--grey);
    margin-bottom: 0;
  }

  .route-card:first-child p:last-child {
    color: rgba(245, 241, 233, 0.76);
  }

  .pending-panel {
    align-items: start;
    background: rgba(212, 201, 191, 0.25);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: clamp(24px, 5vw, 52px);
  }

  .pending-panel h2 {
    font-size: clamp(1.55rem, 3.5vw, 2.4rem);
  }

  .pending-panel p {
    color: var(--grey);
  }

  .pending-list {
    border-top: 2px solid var(--ink);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pending-list li {
    border-bottom: 1px solid var(--lead);
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 2.2vw, 1.42rem);
    padding: 0.9rem 0 0.9rem 1.35rem;
    position: relative;
  }

  .pending-list li::before {
    color: var(--accent);
    content: "-";
    left: 0;
    position: absolute;
  }

  @media (max-width: 900px) {
    .contact-hero-grid,
    .pending-panel {
      grid-template-columns: 1fr;
    }

    .contact-card {
      max-width: 420px;
      width: 100%;
    }

    .route-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contact-hero {
      padding-top: 44px;
    }

    .contact-actions {
      display: block;
    }

    .contact-actions .btn {
      margin-bottom: 0.8rem;
    }

    .pending-panel {
      padding: 1.4rem;
    }
  }
</style>
