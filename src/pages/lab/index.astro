---
import LabPage from '../../components/LabPage.astro';

const zones = [
  {
    title: "个人操作系统",
    href: "/lab/personal-os/",
    label: "核心展区",
    desc: "展示我与 Agent 共建的真实工作体系：输入、认知、管理、推进。",
  },
  {
    title: "Skill 展厅",
    href: "/lab/skills/",
    label: "可复用框架",
    desc: "从真实工作中提炼出的可复用方法，保留现有展品与状态说明。",
  },
  {
    title: "众筹与趣味展厅",
    href: "/lab/crowdfunding/",
    secondaryHref: "/lab/playground/",
    label: "可合作项目 / 玩具实验",
    desc: "记录实验与半成品，展示探索过程；内部页面保持现状。",
  },
];
---

<LabPage title="我与 AI 的协同工作方式" description="AI·LAB 展示思远与 AI 协同工作的真实机制。" eyebrow="AI·LAB" lede="一个人 + 一个工作台 + 一组分工明确的 Agent，AI 如何改变我的工作方式。" status="持续迭代中">

    <section class="section" aria-labelledby="zones-title">
      <div class="container">
        <div class="section-heading">
          <p class="lab-label">三个展区</p>
          <h2 id="zones-title">从工作体系，到可复用方法与未完成实验</h2>
        </div>

        <div class="exhibit-list">
          {zones.map((zone, index) => (
            <article class="exhibit">
              <span class="exhibit-index">{String(index + 1).padStart(2, "0")}</span><div><p class="lab-label">{zone.label}</p><h3>{zone.title}</h3></div><p>{zone.desc}</p><div class="exhibit-actions"><a class="lab-link" href={zone.href}>{zone.secondaryHref ? '进入众筹展厅' : '进入展区'}</a>{zone.secondaryHref && <a class="lab-link" href={zone.secondaryHref}>看趣味实验</a>}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lab-section"><div class="container"><div class="mechanism"><div class="mechanism-step"><span>01 / 人</span><h3>提出问题与承担判断</h3><p>目标、边界与最终取舍仍由人负责。</p></div><div class="mechanism-step"><span>02 / 工作台</span><h3>承接输入与过程</h3><p>材料按职责进入输入、处理、输出与归档。</p></div><div class="mechanism-step"><span>03 / AGENT</span><h3>按明确职责协作</h3><p>不同角色处理研究、整理、执行与检查。</p></div></div></div>
    </section>
</LabPage>
