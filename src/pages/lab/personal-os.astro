---
import LabPage from '../../components/LabPage.astro';
import CoreModelDiagram from '../../components/lab/CoreModelDiagram.astro';
import CockpitDemo from '../../components/lab/CockpitDemo.astro';
const branches=[['我如何和 AI 共用一套大脑','工作台构成协作记忆，让 AI 在授权范围内获得经过人工确认、可持续维护的上下文。','who-i-am'],['我与 AI 如何相处','多 Agent 分工，我握判断权，AI 做执行与放大。','ai-relationship'],['我们的信息如何沉淀到大脑','外部输入如何经过处理，变成可长期调用的认知资产。','knowledge-input'],['我如何管理生活与经营','用同一套操作系统覆盖商业、IP、知识、人脉、健康、财务、系统七个域。','life-and-business'],['我如何推进每天的动作','从每日启动到执行再到收尾，日复一日的动作闭环。','daily-motion']];
---
<LabPage title="个人操作系统" description="展示一个人与一个工作台、一组 Agent 如何协同。" lede="不是买更多 AI 工具，而是搭一套让工具和人协作起来的系统。" status="当前为展示阶段 · 暂不交付">
<section class="lab-section"><div class="container"><div class="lab-heading"><p class="lab-label">核心模式</p><div><h2>个人操作系统如何运转</h2><p>输入被理解、分流、执行、审阅并沉淀为记忆；驾驶舱把重要状态重新交还给人判断，再由人授权下一步执行。</p></div></div><CoreModelDiagram /></div></section>
<section class="lab-section cockpit-demo-section"><div class="container"><div class="lab-heading"><p class="lab-label">系统实景</p><div><h2>它不是一张流程图，而是一套每天都在运行的驾驶舱</h2><p>下面展示的是个人操作系统的演示版本。界面结构来自当前运行中的本地驾驶舱，内容使用统一模拟数据。</p></div></div><CockpitDemo /></div></section>
<section class="lab-section"><div class="container"><div class="lab-heading"><p class="lab-label">五个板块</p><div><h2>从协作上下文，到每天的动作</h2><p>五个长页分别公开记忆、协作、知识、管理与日度推进的机制和边界。</p></div></div><nav class="branch-index" aria-label="个人操作系统五个板块">{branches.map((b,i)=><a class="branch-index-row" href={`/lab/personal-os/${b[2]}/`}><span class="branch-index-number">{String(i+1).padStart(2,'0')}</span><h3>{b[0]}</h3><p>{b[1]}</p><span class="branch-index-link">查看 <span aria-hidden="true">→</span></span></a>)}</nav></div></section>
<section class="lab-section"><div class="container"><table class="status-table"><thead><tr><th>范围</th><th>当前状态</th><th>公开边界</th></tr></thead><tbody><tr><td data-label="范围">工作机制</td><td data-label="当前状态"><span class="state live">展示中</span></td><td data-label="公开边界">展示职责和流程，不公开内部配置。</td></tr><tr><td data-label="范围">个人 OS 1.0</td><td data-label="当前状态"><span class="state frame">暂不交付</span></td><td data-label="公开边界">当前用于展示与启发，不构成售卖承诺。</td></tr></tbody></table><div class="lab-actions" style="margin-top:2rem"><a class="btn" href="/lab/personal-os/who-i-am/">浏览子板块</a><a class="btn btn-outline" href="/lab/skills/">查看 Skill 展厅</a><a class="btn btn-outline" href="/contact/">联系思远</a></div></div></section>
</LabPage>
