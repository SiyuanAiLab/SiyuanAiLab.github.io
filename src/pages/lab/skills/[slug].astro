---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export function getStaticPaths() {
  const skills = {
    "proposal-planning": {
      name: "商业咨询 Skill",
      type: "商业判断",
      status: "已发布 v1.0.0",
      channel: "GitHub · WorkBuddy SkillHub ID 154299",
      github: "https://github.com/SiyuanAiLab/business-consult",
      summary: "从需求澄清到 A/B 骨架，再到可执行方案的结构化流程",
      why: "思远的判断比 AI 生成更值钱；管线的价值是「逼判断、沉认知」。",
      solves: [
        "接到 case 后，不再直接让 AI 写方案，而是先澄清目标、边界和验收口径。",
        "把资料调研、形式定义、A/B 骨架和定稿提案拆成可检查的中间产物。",
        "让最终方案能交接给 Agent、同事或下一阶段执行，而不是停留在聊天记录里。",
      ],
      flow: [
        "Step 0 场景识别",
        "Step 1 需求澄清",
        "Step 2 资料调研",
        "Step 3 形式定义",
        "Step 4 A/B 骨架",
        "Step 5 方案生成",
        "Step 6 交接",
      ],
      takeaway: "SKILL.md + 子 Skill + 模板 + 使用说明",
      fit: "需要写提案、做项目规划、做商业判断的人",
      unfit: "想要一键生成完美方案的人",
      placeholder: false,
    },
    "ai-coach": {
      name: "AI Coach 管线",
      type: "开发辅助",
      status: "已发布 v1.1.0",
      channel: "GitHub · WorkBuddy SkillHub ID 156035",
      github: "https://github.com/SiyuanAiLab/ai-coach",
      summary: "把模糊想法变成可执行的 Skill 开发方案",
      why: "把 Skill 开发从一次性对话变成有判定、有规划、有验收的工程流程。",
      solves: ["辅助深度思考和目标拆解。", "把 Skill 开发需求整理成可执行方案。", "在施工前明确边界与验收口径。"],
      flow: ["需求判定", "方案规划", "分段确认", "执行与验证"],
      takeaway: "Skill 开发的规划、执行与验收框架",
      fit: "需要把模糊想法推进成 Skill 开发任务的人",
      unfit: "只想要一次性聊天建议的人",
      placeholder: false,
    },
    "private-board-prompt": {
      name: "稷下学宫（私董会）",
      type: "决策辅助",
      status: "已发布 v1.1.0",
      channel: "GitHub · WorkBuddy SkillHub ID 157422",
      github: "https://github.com/SiyuanAiLab/private-board",
      summary: "通过多个顾问角色的连续追问，辅助审视重要决策",
      why: "重要决策很容易被单一视角限制；多角色追问用于暴露假设、风险和遗漏。",
      solves: ["在重大选择前引入多视角追问。", "帮助识别机会、风险和盲区。"],
      flow: ["提出决策问题", "多角色审视", "收敛判断"],
      takeaway: "多角色决策审视框架与使用说明",
      fit: "需要在重要决策前换视角的人",
      unfit: "希望 Prompt 替你承担决策后果的人",
      placeholder: false,
    },
    "codex-skills": {
      name: "Codex Skills 探针集",
      type: "公开实验",
      status: "公开 beta 探针",
      channel: "GitHub 公开 monorepo",
      github: "https://github.com/SiyuanAiLab/codex-skills",
      summary: "收录 ai-daily-card 等可复用 Skill 的公开 beta 探针",
      why: "用公开仓库记录 Codex Skill 的结构、说明与迭代，不把 beta 探针包装成成熟产品。",
      solves: ["集中查看当前公开的 Codex Skill 探针。", "按仓库说明理解结构并自行检验。"],
      flow: ["选择探针", "阅读说明", "本地检验", "跟踪迭代"],
      takeaway: "公开 monorepo 中的 beta 探针与说明",
      fit: "想了解或检验 Codex Skill 结构的人",
      unfit: "期待无需配置即可在线运行成熟产品的人",
      placeholder: false,
    },
    "leverage-advisor": {
      name: "杠杆思维顾问",
      type: "思维模型",
      status: "尚未公开",
      summary: "从杠杆视角审视支点、杠杆类型、放大效应和边际成本",
      why: "先保留简洁说明，完整详情二期补齐。",
      solves: ["重新审视问题和资源。", "判断一件事是否有更高杠杆的做法。"],
      flow: ["找支点", "判断杠杆类型", "评估放大效应与边际成本"],
      takeaway: "思维模型 Prompt 尚未公开",
      fit: "需要提高资源使用效率的人",
      unfit: "只想追求短期技巧的人",
      placeholder: true,
    },
    "decision-advisor": {
      name: "决策顾问思维",
      type: "思维模型",
      status: "尚未公开",
      summary: "通过六步苏格拉底式提问把模糊问题变成可执行方案",
      why: "先保留简洁说明，完整详情二期补齐。",
      solves: ["减少情绪对判断的干扰。", "把模糊问题拆成可执行选项。"],
      flow: ["界定问题", "澄清约束", "列出选项", "比较代价", "形成行动"],
      takeaway: "决策提问框架尚未公开",
      fit: "在复杂选择中需要结构化判断的人",
      unfit: "希望 AI 直接替你拍板的人",
      placeholder: true,
    },
    "user-research-insight": {
      name: "用户调研洞察管线",
      type: "工作流",
      status: "开发中",
      summary: "把零散信息变成可验证的用户洞察",
      why: "先保留简洁说明，完整详情二期补齐。",
      solves: ["整理零散访谈、评论和观察。", "把信息变成可验证的用户洞察。"],
      flow: ["收集信息", "归纳主题", "提炼假设", "设计验证"],
      takeaway: "工作流与模板仍在开发",
      fit: "需要从用户信息里提炼判断的人",
      unfit: "没有真实用户信息输入的人",
      placeholder: true,
    },
  };

  return Object.keys(skills).map(slug => ({
    params: { slug },
    props: { skill: skills[slug] },
  }));
}

const { skill } = Astro.props;
---

<Layout title={skill.name} description={`${skill.name}：${skill.summary}`}>
  <Header />

  <main class="site-main skill-detail-page">
    <section class="detail-hero" aria-labelledby="skill-title">
      <div class="container detail-hero-grid">
        <div>
          <p class="kicker">Skill 详情</p>
          <h1 id="skill-title">{skill.name}</h1>
          <p class="hero-lede">{skill.summary}</p>
          <div class="hero-actions">
            <a href="/lab/skills/" class="btn">返回 Skill 展厅</a>
            <a href="/contact/" class="btn btn-outline">关注更新</a>
            {skill.github && (
              <a href={skill.github} class="github-link" target="_blank" rel="noopener noreferrer">
                查看 GitHub 仓库
              </a>
            )}
          </div>
        </div>

        <aside class="status-panel" aria-label="Skill 状态">
          <p class="meta">{skill.type}</p>
          <dl>
            <div>
              <dt>当前状态</dt>
              <dd>{skill.status}</dd>
            </div>
            <div>
              <dt>详情完整度</dt>
              <dd>{skill.placeholder ? "仅保留基本信息" : "公开信息已对齐"}</dd>
            </div>
            <div>
              <dt>开放方式</dt>
              <dd>{skill.channel ?? "尚未公开"}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    {skill.placeholder && (
      <section class="placeholder-note" aria-label="占位说明">
        <div class="container">
          <p>本页只记录目前可公开的基本信息；未发布版本不提供下载或使用入口。</p>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="why-title">
      <div class="container split-grid">
        <div>
          <p class="kicker">为什么做这个</p>
          <h2 id="why-title" class="section-title">设计理念</h2>
        </div>
        <p class="big-copy">{skill.why}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="solve-title">
      <div class="container split-grid">
        <div>
          <p class="kicker">它能解决什么问题</p>
          <h2 id="solve-title" class="section-title">从模糊到可推进</h2>
        </div>
        <ul class="line-list">
          {skill.solves.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="flow-title">
      <div class="container">
        <p class="kicker">核心结构 / 流程</p>
        <h2 id="flow-title" class="section-title">按步骤逼近判断</h2>
        <ol class="flow-list">
          {skill.flow.map(item => <li>{item}</li>)}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="takeaway-title">
      <div class="container fit-grid">
        <article>
          <p class="kicker">你带走什么</p>
          <h2 id="takeaway-title">{skill.takeaway}</h2>
        </article>
        <article>
          <p class="kicker">适合谁</p>
          <p>{skill.fit}</p>
        </article>
        <article>
          <p class="kicker">不适合谁</p>
          <p>{skill.unfit}</p>
        </article>
      </div>
    </section>

    <section class="section final-section" aria-labelledby="final-title">
      <div class="container final-panel">
        <div>
          <p class="kicker">当前状态</p>
          <h2 id="final-title">{skill.status}</h2>
          <p>{skill.github ? "当前公开入口以 GitHub 仓库为准；页面只陈述已确认的版本与渠道信息。" : "未发布内容只展示当前可确认的结构和开发状态。"}</p>
        </div>
        {skill.github ? (
          <a href={skill.github} class="btn" target="_blank" rel="noopener noreferrer">打开 GitHub</a>
        ) : (
          <a href="/lab/skills/" class="btn">查看 Skill 展厅</a>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .skill-detail-page {
    overflow: hidden;
  }

  .detail-hero {
    padding: clamp(56px, 8vw, 96px) 0 clamp(42px, 7vw, 84px);
  }

  .detail-hero-grid,
  .split-grid,
  .final-panel {
    display: grid;
    gap: clamp(28px, 6vw, 76px);
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
  }

  .detail-hero-grid,
  .final-panel {
    align-items: center;
  }

  .kicker,
  .meta {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 1.2rem;
  }

  .meta {
    font-size: 0.76rem;
  }

  .detail-hero h1 {
    font-size: clamp(2.35rem, 6vw, 4.7rem);
    line-height: 1.08;
  }

  .hero-lede,
  .big-copy {
    color: var(--grey);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.5rem;
  }

  .github-link {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-underline-offset: 0.2em;
  }

  .status-panel,
  .final-panel {
    background: rgba(245, 241, 233, 0.8);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: clamp(22px, 4vw, 36px);
  }

  .status-panel dl {
    display: grid;
    gap: 1rem;
  }

  .status-panel div {
    border-top: 1px solid var(--lead);
    padding-top: 1rem;
  }

  .status-panel dt {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .status-panel dd {
    margin: 0.25rem 0 0;
  }

  .placeholder-note .container {
    background: rgba(212, 201, 191, 0.25);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .placeholder-note p {
    color: var(--grey);
    margin-bottom: 0;
    max-width: none;
  }

  .line-list {
    border-top: 2px solid var(--ink);
    list-style: none;
    margin: 0;
  }

  .line-list li {
    border-bottom: 1px solid var(--lead);
    padding: 1rem 0;
  }

  .flow-list {
    counter-reset: flow;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin-top: var(--space-block);
  }

  .flow-list li {
    background: rgba(245, 241, 233, 0.78);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    min-height: 150px;
    padding: clamp(18px, 3vw, 28px);
  }

  .flow-list li::before {
    color: var(--lead);
    content: counter(flow, decimal-leading-zero);
    counter-increment: flow;
    display: block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin-bottom: 2.5rem;
  }

  .fit-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
  }

  .fit-grid article {
    background: rgba(245, 241, 233, 0.78);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: clamp(20px, 3vw, 30px);
  }

  .fit-grid p:last-child {
    color: var(--grey);
    margin-bottom: 0;
  }

  .final-panel {
    background: var(--ink);
    color: var(--paper);
  }

  .final-panel p,
  .final-panel .kicker {
    color: rgba(245, 241, 233, 0.75);
  }

  .final-panel .btn {
    justify-self: end;
  }

  @media (max-width: 980px) {
    .flow-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .fit-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .detail-hero-grid,
    .split-grid,
    .final-panel,
    .flow-list {
      grid-template-columns: 1fr;
    }

    .final-panel .btn {
      justify-self: start;
    }
  }
</style>
