---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((article) => article.data.public && !article.data.draft && article.data.auditStatus === 'approved')
    .map((article) => ({
      params: { slug: article.id.replace(/\.mdx?$/, '') },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const categoryMeta = {
  'qingxing-shike': { title: '清醒时刻', author: '思远' },
  luodizhi: { title: '落地志', author: '思远' },
  tools: { title: '工具实测', author: '思远' },
  'siyuan-observation-diary': { title: '思远观察日记', author: 'Claudian' },
} as const;

const fallback = categoryMeta[article.data.category];
const articleMeta = `${article.data.seriesTitle ?? fallback.title} · ${article.data.author ?? fallback.author}`;
---

<Layout title={article.data.title} description={article.data.description}>
  <Header />

  <main class="site-main article-page">
    <article class="container article-shell">
      <a class="back-link" href="/articles">返回文章</a>
      <header class="article-header">
        <p class="meta">{articleMeta}</p>
        <h1>{article.data.title}</h1>
        <p>{article.data.description}</p>
      </header>

      <div class="article-meta">
        <span>{article.data.pubDate.toLocaleDateString('zh-CN')}</span>
        {article.data.readingTime && <span>{article.data.readingTime}</span>}
        {article.data.episode && <span>{article.data.episode}</span>}
      </div>

      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .article-shell {
    max-width: 820px;
    padding-bottom: var(--space-section);
    padding-top: clamp(56px, 8vw, 96px);
  }

  .back-link {
    display: inline-block;
    font-weight: 700;
    margin-bottom: 1.8rem;
  }

  .article-header {
    border-bottom: 2px solid var(--ink);
    margin-bottom: 1.4rem;
    padding-bottom: 1.4rem;
  }

  .article-header h1 {
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .article-header p:last-child,
  .article-content :global(p),
  .article-content :global(li) {
    color: var(--grey);
  }

  .article-meta {
    color: var(--grey);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    gap: 0.6rem 1.2rem;
    margin-bottom: var(--space-block);
  }

  .article-content :global(h2) {
    border-top: 1px solid var(--lead);
    margin-top: 2.4rem;
    padding-top: 1.4rem;
  }

  .article-content :global(p) {
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .article-content :global(a) {
    font-weight: 700;
  }

  .article-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    color: var(--ink);
    margin: 2rem 0;
    padding-left: 1.2rem;
  }
</style>
