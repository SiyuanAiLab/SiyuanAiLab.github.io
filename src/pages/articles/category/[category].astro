---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'qingxing-shike', title: '清醒时刻', desc: '判断 AI 时代真实发生的变化。' },
    { slug: 'luodizhi', title: '落地志', desc: '记录 AI 进入真实工作流的过程。' },
    { slug: 'tools', title: '工具实测', desc: '筛选能进入业务流程的工具。' },
  ];

  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter((article) => article.data.category === category.slug)
  .filter((article) => article.data.public && !article.data.draft && article.data.auditStatus === 'approved')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={category.title} description={`${category.title}文章分类，${category.desc}`}>
  <Header />

  <main class="site-main category-page">
    <section class="section">
      <div class="container">
        <a class="back-link" href="/articles">返回文章</a>
        <h1>{category.title}</h1>
        <p class="category-lede">{category.desc}</p>

        {articles.length > 0 ? (
          <div class="article-list">
            {articles.map((article) => (
              <a class="article-row" href={`/articles/${article.id.replace(/\.mdx?$/, '')}`}>
                <span class="meta">{article.data.pubDate.toLocaleDateString('zh-CN')}</span>
                <h2>{article.data.title}</h2>
                <p>{article.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>这个分类的公开文章整理中</h2>
            <p>内容资产线程会先完成审核，再把文章发布到这里。</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .back-link {
    display: inline-block;
    font-weight: 700;
    margin-bottom: 1.4rem;
  }

  .category-page h1 {
    font-size: clamp(2.1rem, 5vw, 4rem);
  }

  .category-lede,
  .article-row p,
  .empty-state p {
    color: var(--grey);
  }

  .article-list {
    display: grid;
    gap: 1rem;
    margin-top: var(--space-block);
  }

  .article-row {
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    color: var(--ink);
    display: block;
    padding: clamp(20px, 3vw, 30px);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .article-row:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .empty-state {
    background: rgba(212, 201, 191, 0.25);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    margin-top: var(--space-block);
    padding: clamp(24px, 5vw, 48px);
  }
</style>
