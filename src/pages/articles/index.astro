---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const categoryMeta = {
  'qingxing-shike': {
    title: '清醒时刻',
    author: '思远',
    desc: '对 AI 时代、工作流和社会的长期判断。',
  },
  'siyuan-observation-diary': {
    title: '思远观察日记',
    author: 'Claudian',
    desc: '每天一个真实工作场景的副驾驶记录。',
  },
} as const;

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((article) => article.data.public && !article.data.draft && article.data.auditStatus === 'approved')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

type Article = (typeof publishedArticles)[number];

const byCategory = (category: keyof typeof categoryMeta) =>
  publishedArticles.filter((article) => article.data.category === category);

const qingxingArticles = byCategory('qingxing-shike').slice(0, 5);
const diaryArticles = byCategory('siyuan-observation-diary').slice(0, 7);

const selectFeatured = (articles: Article[]) =>
  [...articles].sort((a, b) => {
    const featuredDiff = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
    return featuredDiff || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })[0];

const featuredJudgment = selectFeatured(byCategory('qingxing-shike'));
const featuredObservation = selectFeatured(byCategory('siyuan-observation-diary'));

const articleSlug = (article: Article) => article.id.replace(/\.mdx?$/, '');
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');
const getMonthKey = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;

const diaryMonths = Array.from(
  byCategory('siyuan-observation-diary')
    .reduce((months, article) => {
      const key = getMonthKey(article.data.pubDate);
      months.set(key, (months.get(key) ?? 0) + 1);
      return months;
    }, new Map<string, number>())
    .entries(),
).map(([month, count]) => {
  const [year, monthNumber] = month.split('-');
  return {
    month,
    count,
    label: `${year} 年 ${Number(monthNumber)} 月 · ${count} 篇`,
  };
});
---

<Layout title="AI·观" description="思远 AI Lab 的双视角文章入口：思远的判断与 Claudian 的观察。">
  <Header />

  <main class="site-main articles-page">
    <section class="articles-hero">
      <div class="container">
        <p class="kicker">两种视角，同一个人</p>
        <h1>AI·观</h1>
        <p class="articles-subhead">
          我看世界的方式，Claudian 看我的方式。
        </p>
        <p class="articles-lede">
          这里有两条并行的记录。我读 AI 时代的变化，Claudian 读我。你既可以读判断，也可以读观察；最终都会指向同一个人。
        </p>
      </div>
    </section>

    <section class="section featured-section" aria-label="精选视角">
      <div class="container featured-pair">
        <article class="featured-card featured-card-dark" data-search-item={featuredJudgment ? JSON.stringify({ title: featuredJudgment.data.title, description: featuredJudgment.data.description, author: categoryMeta['qingxing-shike'].author, category: categoryMeta['qingxing-shike'].title }) : undefined}>
          <p class="meta">清醒时刻 · 思远</p>
          {featuredJudgment ? (
            <>
              <h2>{featuredJudgment.data.title}</h2>
              <p>{featuredJudgment.data.description}</p>
              {featuredJudgment.data.featuredReason && <p class="featured-reason">{featuredJudgment.data.featuredReason}</p>}
              <div class="card-foot">
                <span>{formatDate(featuredJudgment.data.pubDate)}</span>
                <a href={`/articles/${articleSlug(featuredJudgment)}`}>读这篇判断 →</a>
              </div>
            </>
          ) : (
            <>
              <h2>这个视角的文章正在整理中。</h2>
              <p>清醒时刻会在审核完成后出现在这里。</p>
            </>
          )}
        </article>

        <article class="featured-card featured-card-light" data-observation-empty={featuredObservation ? undefined : 'true'} data-search-item={featuredObservation ? JSON.stringify({ title: featuredObservation.data.title, description: featuredObservation.data.description, author: categoryMeta['siyuan-observation-diary'].author, category: categoryMeta['siyuan-observation-diary'].title }) : undefined}>
          <p class="meta">思远观察日记 · Claudian</p>
          {featuredObservation ? (
            <>
              <h2>{featuredObservation.data.title}</h2>
              <p>{featuredObservation.data.description}</p>
              <div class="card-foot">
                <span>{featuredObservation.data.episode ?? formatDate(featuredObservation.data.pubDate)}</span>
                <a href={`/articles/${articleSlug(featuredObservation)}`}>读这篇观察 →</a>
              </div>
            </>
          ) : (
            <>
              <h2>这个视角的文章正在整理中。</h2>
              <p>思远观察日记正在审核整理中，近期发布。</p>
              <div class="card-foot">
                <span>暂无公开文章</span>
                <a href="/articles/category/siyuan-observation-diary">查看栏目 →</a>
              </div>
            </>
          )}
        </article>
      </div>
    </section>

    <section class="section judgment-section">
      <div class="container">
        <div class="section-heading">
          <h2>思远的判断</h2>
          <p>对 AI 时代、工作流和社会的长期判断。</p>
        </div>

        <div class="judgment-list">
          {qingxingArticles.map((article) => (
            <a class="judgment-row" href={`/articles/${articleSlug(article)}`} data-search-item={JSON.stringify({ title: article.data.title, description: article.data.description, author: categoryMeta['qingxing-shike'].author, category: categoryMeta['qingxing-shike'].title })}>
              <span class="meta">{formatDate(article.data.pubDate)} · {article.data.readingTime ?? '阅读全文'}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </a>
          ))}
        </div>

        <a class="section-link" href="/articles/category/qingxing-shike">查看全部清醒时刻 →</a>
      </div>
    </section>

    <section class="section observation-section">
      <div class="container observation-layout">
        <div class="section-heading">
          <h2>Claudian 的观察</h2>
          <p>每天一个真实工作场景的副驾驶记录。</p>
        </div>

        {diaryArticles.length > 0 ? (
          <div class="diary-list">
            {diaryArticles.map((article) => (
              <a class="diary-row" href={`/articles/${articleSlug(article)}`} data-search-item={JSON.stringify({ title: article.data.title, description: article.data.description, author: categoryMeta['siyuan-observation-diary'].author, category: categoryMeta['siyuan-observation-diary'].title })}>
                <span class="diary-episode">{article.data.episode ?? getMonthKey(article.data.pubDate)}</span>
                <span>
                  <strong>{article.data.title}</strong>
                  <small>{formatDate(article.data.pubDate)} · {article.data.description}</small>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state observation-empty">
            <h3>思远观察日记正在审核整理中，近期发布。</h3>
            <p>这里会保留 Claudian 站在副驾驶位置看到的协作现场。</p>
          </div>
        )}

        <a class="section-link" href="/articles/category/siyuan-observation-diary">按月份查看全部 →</a>
      </div>
    </section>

    <section class="section month-section">
      <div class="container">
        <div class="section-heading">
          <h2>按月查看</h2>
          <p>日记每天都在更新。</p>
        </div>

        {diaryMonths.length > 0 ? (
          <div class="month-grid">
            {diaryMonths.map((month) => (
              <a class="month-card" href={`/articles/category/siyuan-observation-diary?month=${month.month}`} data-search-item={JSON.stringify({ title: month.label, description: '', author: categoryMeta['siyuan-observation-diary'].author, category: categoryMeta['siyuan-observation-diary'].title })}>
                {month.label}
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state compact-empty">
            <h3>还没有可归档的公开日记。</h3>
            <p>首批日记公开后，这里会按月份自动出现入口。</p>
          </div>
        )}
      </div>
    </section>

    <section class="section search-section">
      <div class="container search-panel">
        <div class="section-heading">
          <h2>搜索全部文章</h2>
          <p>按作者、格式或主题查找。</p>
        </div>

        <div class="search-box" aria-label="搜索全部文章">
          <label for="article-search">搜索关键词</label>
          <input id="article-search" type="search" placeholder="搜索标题、主题或作者" autocomplete="off" />
          <div class="filter-tags" aria-label="作者筛选">
            <a href="/articles/category/qingxing-shike">思远</a>
            <a href="/articles/category/siyuan-observation-diary">Claudian</a>
          </div>
          <p id="search-empty-state" class="search-empty" hidden>没有匹配的文章。</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (() => {
    const input = document.getElementById('article-search');
    if (!input) return;

    const sections = [
      { el: document.querySelector('.featured-section'), selector: '.featured-card[data-search-item]' },
      { el: document.querySelector('.judgment-section'), selector: '.judgment-row[data-search-item]' },
      { el: document.querySelector('.observation-section'), selector: '.diary-row[data-search-item]' },
      { el: document.querySelector('.month-section'), selector: '.month-card[data-search-item]' },
    ].filter((s) => s.el);

    const emptyState = document.getElementById('search-empty-state');
    const normalize = (value) => String(value || '').toLowerCase().trim();

    const filter = (query) => {
      const needle = normalize(query);
      let totalVisible = 0;

      sections.forEach(({ el, selector }) => {
        const items = Array.from(el.querySelectorAll(selector));
        let sectionVisible = 0;
        items.forEach((item) => {
          const data = JSON.parse(item.dataset.searchItem || '{}');
          const haystack = normalize([data.title, data.description, data.author, data.category].join(' '));
          const visible = !needle || haystack.includes(needle);
          item.hidden = !visible;
          if (visible) sectionVisible += 1;
        });
        el.hidden = sectionVisible === 0;
        totalVisible += sectionVisible;
      });

      if (emptyState) {
        emptyState.hidden = totalVisible > 0 || !needle;
      }
    };

    input.addEventListener('input', (event) => filter(event.target.value));
    filter(input.value);
  })();
</script>

<style>
  .articles-page {
    --panel: rgba(245, 241, 233, 0.78);
    --panel-strong: rgba(212, 201, 191, 0.25);
  }

  .articles-hero {
    padding: clamp(56px, 7vw, 88px) 0 clamp(28px, 5vw, 56px);
  }

  .kicker,
  .meta {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 1rem;
  }

  .articles-hero h1 {
    font-size: clamp(2.2rem, 5.2vw, 4.2rem);
    max-width: 900px;
  }

  .articles-subhead {
    color: var(--grey);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    margin: 0.6rem 0 1.2rem;
    max-width: 760px;
  }

  .articles-lede {
    color: var(--grey);
    font-size: clamp(1.04rem, 1.7vw, 1.22rem);
    max-width: 760px;
  }

  .featured-section {
    padding-top: 0;
  }

  .featured-pair {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }

  .featured-card {
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    min-height: clamp(320px, 42vw, 460px);
    padding: clamp(24px, 4vw, 44px);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .featured-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    transform: translateY(-2px);
  }

  .featured-card h2 {
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    margin-top: auto;
  }

  .featured-card p {
    margin-bottom: 0;
  }

  .featured-card-dark {
    background: var(--ink);
    color: var(--paper);
  }

  .featured-card-dark p,
  .featured-card-dark .meta,
  .featured-card-dark span,
  .featured-card-dark a {
    color: rgba(245, 241, 233, 0.78);
  }

  .featured-card-dark a:hover {
    color: var(--paper);
  }

  .featured-card-light {
    background: var(--panel);
    color: var(--ink);
  }

  .featured-reason {
    border-left: 2px solid var(--accent);
    color: rgba(245, 241, 233, 0.72);
    margin-top: 1rem;
    padding-left: 1rem;
  }

  .card-foot {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    gap: 0.8rem 1.2rem;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .card-foot a,
  .section-link {
    font-weight: 700;
  }

  .section-heading {
    margin-bottom: var(--space-block);
  }

  .section-heading h2 {
    border-bottom: 2px solid var(--ink);
    max-width: 720px;
    padding-bottom: 0.65rem;
  }

  .section-heading p {
    color: var(--grey);
    font-size: 1rem;
  }

  .judgment-list {
    display: grid;
    gap: 0.9rem;
  }

  .judgment-row,
  .diary-row,
  .month-card {
    background: var(--panel);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    color: var(--ink);
    display: block;
    padding: clamp(18px, 3vw, 28px);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .judgment-row:hover,
  .diary-row:hover,
  .month-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .judgment-row h3 {
    font-size: clamp(1.18rem, 2.4vw, 1.6rem);
  }

  .judgment-row p,
  .diary-row small,
  .empty-state p {
    color: var(--grey);
  }

  .section-link {
    display: inline-block;
    margin-top: 1.5rem;
  }

  .observation-layout {
    display: grid;
    gap: 1.2rem;
  }

  .diary-list,
  .month-grid {
    display: grid;
    gap: 0.9rem;
  }

  .diary-row {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(72px, 0.18fr) minmax(0, 1fr);
  }

  .diary-episode {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .diary-row strong,
  .diary-row small {
    display: block;
  }

  .diary-row small {
    margin-top: 0.35rem;
  }

  .empty-state {
    background: var(--panel-strong);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: clamp(24px, 5vw, 48px);
  }

  .observation-empty {
    min-height: 220px;
  }

  .compact-empty {
    padding: clamp(20px, 4vw, 32px);
  }

  .month-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .month-card {
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }

  .search-panel {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-block);
  }

  .search-box {
    display: grid;
    gap: 0.85rem;
    max-width: 760px;
  }

  .search-box label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .search-box input {
    background: rgba(245, 241, 233, 0.9);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    color: var(--ink);
    font: inherit;
    min-height: 54px;
    padding: 0 1rem;
  }

  .search-box input::placeholder {
    color: var(--grey);
    opacity: 1;
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .filter-tags a {
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.45rem 0.75rem;
    text-decoration: none;
  }

  .filter-tags a:hover {
    border-color: var(--accent);
  }

  .search-empty {
    color: var(--grey);
    margin: 0.5rem 0 0;
  }

  @media (max-width: 900px) {
    .featured-pair,
    .diary-row {
      grid-template-columns: 1fr;
    }

    .featured-card {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .judgment-row,
    .diary-row,
    .month-card {
      transition: none;
    }

    .featured-card:hover,
    .judgment-row:hover,
    .diary-row:hover,
    .month-card:hover {
      transform: none;
    }
  }
</style>
