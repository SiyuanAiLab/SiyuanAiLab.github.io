---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import KnowledgeSearch from '../../../components/KnowledgeSearch.astro';
import workflowData from '../../../data/workflow-cards.json';
import knowledgeData from '../../../data/knowledge-cards.json';

const cards = workflowData.cards
  .slice()
  .sort((a, b) => a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));

const categories = workflowData.categories;
const skillLibrary = categories.find((category) => category.id === 'skill-library');
const agentBuilding = categories.find((category) => category.id === 'agent-building');

const searchItems = cards.map((card) => {
  const category = categories.find((item) => item.id === card.category);
  const subcategory = category?.subcategories.find((item) => item.id === card.subcategory);
  return {
    id: card.id,
    title: card.title,
    title_en: card.title_en,
    summary: card.summary,
    tags: card.tags,
    scenario: card.scenario,
    columnTitle: subcategory ? `${category?.title} · ${subcategory.title}` : category?.title,
    url: `/knowledge/workflows/${card.category}/${card.subcategory}/${card.slug}/`,
  };
});

const recommendedCards = workflowData.recommendations
  .map((recommendation) => {
    const card = knowledgeData.cards.find((item) => item.slug === recommendation.slug);
    if (!card) return null;
    const column = knowledgeData.columns.find((item) => item.id === card.column);
    return { ...card, reason: recommendation.reason, columnTitle: column?.title };
  })
  .filter(Boolean);
---

<Layout title="工作流 — AI·外脑" description="思远 AI Lab 工作流专栏，按 Agent 能力栈组织基础设施、Skill 生产线、Skill 参考库和 Agent Building。">
  <Header />

  <main class="site-main">
    <section class="hero workflow-hero">
      <div class="container">
        <p class="kicker">工作流</p>
        <h1>给 AI 装配能力的参考手册</h1>
        <p class="lede">
          按 Agent 的成长路径组织：先看基础设施，再看 Skill 生产线，再查 Skill 参考库，最后判断是否需要升级到 Agent Building。
        </p>
        <KnowledgeSearch items={searchItems} id="workflow-home-search" placeholder="搜索 Skill、工具、Agent Building、标签" />
      </div>
    </section>

    <section class="section entry-section">
      <div class="container">
        <div class="section-heading">
          <p class="kicker">Agent 能力栈</p>
          <h2 class="section-title">四层入口</h2>
        </div>

        <div class="layer-grid">
          {categories.map((category, index) => (
            <article class={`layer-card ${category.id === 'agent-building' ? 'agent-card' : ''}`}>
              <a class="layer-head" href={`/knowledge/workflows/${category.id}/${category.subcategories[0]?.id}/`}>
                <span class="entry-index">{String(index + 1).padStart(2, '0')}</span>
                <h3>{category.title}</h3>
                <strong>{category.title_en}</strong>
                <p>{category.description}</p>
              </a>
              {category.id === 'agent-building' && category.standard && (
                <p class="agent-standard">{category.standard}</p>
              )}
              <div class="subcategory-links">
                {category.subcategories.map((item) => (
                  <a href={`/knowledge/workflows/${category.id}/${item.id}/`}>
                    <span>{item.title}</span>
                    <small>{item.title_en}</small>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section entry-section">
      <div class="container">
        <div class="section-heading">
          <p class="kicker">Skill Library</p>
          <h2 class="section-title">参考库 7 个场景区</h2>
          <p class="section-copy">
            v2.1 保留 7 个企业服务和知识工作场景，并把“商业与营销”纳入参考库。
          </p>
        </div>

        <div class="entry-grid topic-grid">
          {skillLibrary?.subcategories.map((item) => (
            <a class="entry-card topic-card" href={`/knowledge/workflows/skill-library/${item.id}/`}>
              <span class="entry-index">{item.title_en}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section agent-standard-section">
      <div class="container">
        <div class="agent-standard-panel">
          <div>
            <p class="kicker">Agent Building</p>
            <h2 class="section-title">这里只收真 Agent</h2>
          </div>
          <p>
            {agentBuilding?.standard}
          </p>
        </div>
      </div>
    </section>

    <section class="section featured-section">
      <div class="container">
        <div class="section-heading">
          <p class="kicker">推荐知识卡片</p>
          <h2 class="section-title">理解 Skill 前，先补这几块底层积木</h2>
        </div>

        <div class="featured-grid">
          {recommendedCards.map((card) => (
            <a class="knowledge-card" href={`/knowledge/ai-core/${card.column}/${card.slug}/`}>
              <span class="card-id">{card.id} · {card.columnTitle}</span>
              <h3>{card.title}</h3>
              <p class="title-en">{card.title_en}</p>
              <p>{card.reason}</p>
              <strong>进入概念卡片</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section notice-section">
      <div class="container">
        <p class="notice">
          当前已入站 {cards.length} 张公开版工作流解读卡，内容按公开 README 和已审核草稿整理。
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .workflow-hero {
    padding-bottom: clamp(42px, 7vw, 76px);
  }

  h1 {
    max-width: 820px;
  }

  .lede {
    color: var(--grey);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    max-width: 720px;
    margin-bottom: 1.75rem;
  }

  .entry-section,
  .agent-standard-section,
  .featured-section,
  .notice-section {
    padding-top: 0;
  }

  .section-heading {
    max-width: var(--content-max);
    margin-bottom: 1.8rem;
  }

  .section-copy {
    color: var(--grey);
    max-width: 720px;
  }

  .entry-grid,
  .featured-grid,
  .layer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }

  .layer-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    align-items: stretch;
  }

  .topic-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .entry-card,
  .knowledge-card,
  .layer-card,
  .agent-standard-panel {
    display: block;
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    background: rgba(245, 241, 233, 0.74);
    padding: 1.15rem;
    text-decoration: none;
  }

  .entry-card,
  .knowledge-card {
    min-height: 210px;
  }

  .entry-card:hover,
  .knowledge-card:hover,
  .layer-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    color: var(--ink);
  }

  .layer-card {
    border-top: 3px solid var(--ink);
  }

  .agent-card {
    border-top-color: var(--accent);
  }

  .layer-head {
    display: block;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .layer-head p {
    color: var(--grey);
    margin-top: 0.6rem;
  }

  .subcategory-links {
    display: grid;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .subcategory-links a {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    align-items: baseline;
    border-top: 1px solid rgba(184, 184, 184, 0.42);
    padding-top: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }

  .subcategory-links a:hover {
    color: var(--accent);
  }

  .subcategory-links small {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: right;
  }

  .agent-standard,
  .agent-standard-panel p {
    color: var(--grey);
    font-size: 0.92rem;
    border-left: 2px solid var(--accent);
    padding-left: 0.85rem;
  }

  .agent-standard-panel {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(18px, 4vw, 40px);
    align-items: start;
    max-width: 1040px;
  }

  .entry-index,
  .card-id,
  .knowledge-card strong {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin-bottom: 0.7rem;
  }

  .entry-card h3,
  .knowledge-card h3 {
    font-size: 1.22rem;
    margin-bottom: 0.6rem;
  }

  .entry-card p,
  .layer-card p,
  .knowledge-card p,
  .notice {
    color: var(--grey);
  }

  .entry-card strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .knowledge-card .title-en {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.6rem;
  }

  .notice {
    max-width: var(--content-max);
    border-top: 1px solid var(--lead);
    padding-top: 1rem;
    font-size: 0.92rem;
  }

  @media (max-width: 720px) {
    .agent-standard-panel {
      display: block;
    }

    .subcategory-links a {
      display: block;
    }

    .subcategory-links small {
      display: block;
      text-align: left;
      margin-top: 0.15rem;
    }
  }
</style>
