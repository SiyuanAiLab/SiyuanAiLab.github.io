---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import KnowledgeDirectory from '../../../components/KnowledgeDirectory.astro';
import WorkflowTree from '../../../components/WorkflowTree.astro';
import CardTable from '../../../components/CardTable.astro';
import workflowData from '../../../data/workflow-cards.json';

const cards = workflowData.cards
  .slice()
  .sort((a, b) => a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));

const categories = workflowData.categories;
const categoryRows = categories.map((category, index) => ({
  id: String(index + 1).padStart(2, '0'),
  title: category.title,
  title_en: category.title_en,
  summary: category.description,
  tags: category.subcategories.map((subcategory) => subcategory.title),
  url: `/knowledge/workflows/${category.id}/${category.subcategories[0]?.id}/`,
}));
---

<Layout title="工作流 - AI·外脑" description="纸间拾光工作流专栏，按 Agent 能力栈组织基础设施、Skill 生产线、Skill 参考库和 Agent Building。">
  <Header />

  <main class="site-main workflow-page">
    <div class="container knowledge-layout">
      <KnowledgeDirectory activeSection="workflows">
        <WorkflowTree categories={categories} cards={cards} />
      </KnowledgeDirectory>

      <section class="main-content knowledge-main">
        <header class="workflow-hero">
        <p class="kicker">工作流</p>
        <h1>给 AI 装配能力的参考手册</h1>
        <p class="lede">
          按 Agent 的成长路径组织：先看基础设施，再看 Skill 生产线，再查 Skill 参考库，最后判断是否需要升级到 Agent Building。
        </p>
        </header>

        <section class="workflow-stack">
        <div class="section-heading">
          <h2 class="section-title">四层入口</h2>
          <p>从运行基础到多 Agent 协作，先按层级定位，再进入左侧子目录查具体词条。</p>
        </div>

        <CardTable
          cards={categoryRows}
          label="工作流四层能力栈"
          urlBuilder={(category) => category.url}
        />
        </section>
        <p class="notice">当前公开 {cards.length} 张工作流解读卡。具体词条可从左侧子目录进入。</p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .workflow-page {
    padding: clamp(28px, 5vw, 56px) 0;
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .workflow-hero {
    padding-bottom: clamp(32px, 5vw, 52px);
  }

  .workflow-stack {
    margin-bottom: 2rem;
  }

  h1 {
    max-width: 820px;
  }

  .lede {
    color: var(--grey);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    max-width: 720px;
    margin-bottom: 1.75rem;
  }

  .entry-section,
  .agent-standard-section,
  .featured-section,
  .notice-section {
    padding-top: 0;
  }

  .section-heading {
    max-width: var(--content-max);
    margin-bottom: 1.8rem;
  }

  .section-copy {
    color: var(--grey);
    max-width: 720px;
  }

  .entry-grid,
  .featured-grid,
  .layer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }

  .layer-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    align-items: stretch;
  }

  .topic-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .entry-card,
  .knowledge-card,
  .layer-card,
  .agent-standard-panel {
    display: block;
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    background: rgba(245, 241, 233, 0.74);
    padding: 1.15rem;
    text-decoration: none;
  }

  .entry-card,
  .knowledge-card {
    min-height: 210px;
  }

  .entry-card:hover,
  .knowledge-card:hover,
  .layer-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    color: var(--ink);
  }

  .layer-card {
    border-top: 3px solid var(--ink);
  }

  .agent-card {
    border-top-color: var(--accent);
  }

  .layer-head {
    display: block;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .layer-head p {
    color: var(--grey);
    margin-top: 0.6rem;
  }

  .subcategory-links {
    display: grid;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .subcategory-links a {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    align-items: baseline;
    border-top: 1px solid rgba(184, 184, 184, 0.42);
    padding-top: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }

  .subcategory-links a:hover {
    color: var(--accent);
  }

  .subcategory-links small {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: right;
  }

  .agent-standard,
  .agent-standard-panel p {
    color: var(--grey);
    font-size: 0.92rem;
    border-left: 2px solid var(--accent);
    padding-left: 0.85rem;
  }

  .agent-standard-panel {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(18px, 4vw, 40px);
    align-items: start;
    max-width: 1040px;
  }

  .entry-index,
  .card-id,
  .knowledge-card strong {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin-bottom: 0.7rem;
  }

  .entry-card h3,
  .knowledge-card h3 {
    font-size: 1.22rem;
    margin-bottom: 0.6rem;
  }

  .entry-card p,
  .layer-card p,
  .knowledge-card p,
  .notice {
    color: var(--grey);
  }

  .entry-card strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .knowledge-card .title-en {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.6rem;
  }

  .notice {
    max-width: var(--content-max);
    border-top: 1px solid var(--lead);
    padding-top: 1rem;
    font-size: 0.92rem;
  }

  @media (max-width: 720px) {
    .agent-standard-panel {
      display: block;
    }

    .subcategory-links a {
      display: block;
    }

    .subcategory-links small {
      display: block;
      text-align: left;
      margin-top: 0.15rem;
    }
  }
</style>
