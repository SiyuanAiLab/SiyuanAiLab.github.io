---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import KnowledgeSearch from '../../components/KnowledgeSearch.astro';
import AcquisitionPanel from '../../components/AcquisitionPanel.astro';
import {
  buildGlobalSearchItems,
  knowledgePillars,
  knowledgeTopics,
} from '../../data/knowledge-directory';

const searchItems = await buildGlobalSearchItems();
---

<Layout title="AI·外脑" description="思行致远的 AI·外脑，是给 Agent 读的第二大脑。我把自己的 Knowledge 体系公开出来，让 AI 直接读取、复制、吸收。">
  <Header />

  <main class="site-main">
    <section class="hero knowledge-hero">
      <div class="container">
        <p class="kicker">给 Agent 读的第二大脑</p>
        <h1>AI·外脑</h1>
        <p class="lede">
          我把自己的 Knowledge 体系公开出来，让 AI 直接读取、复制、吸收。你也能把它搬进你的 Agent，让它成为你的第二大脑。
        </p>
        <KnowledgeSearch items={searchItems} id="knowledge-home-search" placeholder="搜索全部概念、工作流、工具、信源和职业能力" />
      </div>
    </section>

    <section class="section intro-section">
      <div class="container">
        <div class="intro-grid">
          <article class="intro-panel">
            <h2>为什么会有这个想法？</h2>
            <p>现在讲「用 AI 做知识管理」的内容很多，但大部分停留在一个 LLM、一份 Wiki、一个 Obsidian。工具没有错，问题在结构。</p>
            <ul class="reason-list">
              <li><strong>目录不清晰</strong><span>信息和判断混在一起，Agent 不知道该读哪一段。</span></li>
              <li><strong>命中不准</strong><span>搜索返回的是关键词，不是经过验证的判断。</span></li>
              <li><strong>上手门槛高</strong><span>教程主要给人看，AI 难以直接读取和执行。</span></li>
            </ul>
            <p class="intro-conclusion">真正稀缺的，是一套能被 Agent 调用的判断体系。</p>
          </article>

          <article class="intro-panel">
            <h2>AI 外脑到底是什么？</h2>
            <p>AI·外脑不是 Obsidian 使用技巧。Obsidian 只是展示平台，核心是背后的文件夹目录体系。</p>
            <p>它给 AI 提供「阅读什么」和「如何构建」的理论依据：先掌握哪些概念、复制哪些工作流、在什么场景选择什么工具、引用哪些信源与标准。</p>
            <p>目前公开的是我经过交叉验证的通用知识卡片。它们不是百科全书，而是 Agent 可以先读、再判断、再行动的底层装备。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section acquisition-section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">获取 AI·外脑</h2>
          <p>三种获取方式都在准备中。正式可用前只说明规划和状态，不提供无效地址或占位命令。</p>
        </div>
        <AcquisitionPanel compact={true} />
        <a class="text-link acquisition-link" href="/knowledge/install/">查看获取方式说明</a>
      </div>
    </section>

    <section class="section directory-section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">按目录进入 AI·外脑</h2>
          <p>主要栏目按可调用的装备类型组织。先选目录，再在栏目表格里扫描词条。</p>
        </div>

        <div class="pillar-grid">
          {knowledgePillars.map((pillar) => (
            <a class:list={["pillar-card", { "is-pending": pillar.status === 'pending', "is-live": pillar.status === 'open' }]} href={pillar.url}>
              <span class:list={["badge", { "badge-pending": pillar.status === 'pending' }]}>{pillar.statusLabel}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.description}</p>
              <strong>{pillar.status === 'open' ? '进入栏目' : '查看当前状态'}</strong>
            </a>
          ))}
        </div>

        <div class="topic-directory">
          <h3>专题入口</h3>
          <div class="topic-list">
            {knowledgeTopics.map((topic) => (
              <a href={topic.url}>
                <span>
                  <strong>{topic.title}</strong>
                  <small>{topic.description}</small>
                </span>
                <span class="badge">{topic.statusLabel}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.2rem;
  }

  .knowledge-hero {
    padding-bottom: clamp(42px, 7vw, 76px);
  }

  h1 {
    max-width: 760px;
  }

  .lede {
    color: var(--grey);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    max-width: 680px;
    margin-bottom: 1.75rem;
  }

  .start-section,
  .directory-section,
  .featured-section,
  .notice-section {
    padding-top: 0;
  }

  .start-card {
    display: block;
    max-width: var(--content-max);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    background: rgba(26, 26, 26, 0.03);
    padding: clamp(1.4rem, 3vw, 2rem);
    text-decoration: none;
  }

  .start-card:hover,
  .pillar-card.is-live:hover,
  .knowledge-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    color: var(--ink);
  }

  .start-card h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    margin-bottom: 0.7rem;
  }

  .start-card p,
  .section-heading p,
  .pillar-card p,
  .knowledge-card p {
    color: var(--grey);
  }

  .start-card strong,
  .pillar-card strong,
  .text-link {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .section-heading {
    max-width: var(--content-max);
    margin-bottom: 1.8rem;
  }

  .section-heading.compact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .pillar-grid,
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 1rem;
  }

  .pillar-card,
  .knowledge-card {
    display: block;
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    background: rgba(245, 241, 233, 0.72);
    padding: 1.2rem;
    text-decoration: none;
    min-height: 210px;
  }

  .pillar-card.is-pending {
    background: rgba(26, 26, 26, 0.018);
  }

  .pillar-card h3,
  .knowledge-card h3 {
    font-size: 1.22rem;
    margin-bottom: 0.55rem;
  }

  .pillar-card .meta,
  .knowledge-card .card-id {
    display: block;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin-bottom: 0.65rem;
  }

  .knowledge-card .title-en {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.65rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .notice {
    color: var(--grey);
    font-size: 0.95rem;
    max-width: var(--content-max);
    border-top: 1px solid var(--lead);
    padding-top: 1.5rem;
  }

  .intro-section {
    padding-top: 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 6vw, 5rem);
    border-top: 2px solid var(--ink);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .intro-panel h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
  }

  .intro-panel p,
  .reason-list span {
    color: var(--grey);
  }

  .reason-list {
    list-style: none;
    margin: 1.4rem 0;
    padding: 0;
  }

  .reason-list li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 0.8rem;
    border-top: 1px solid rgba(184, 184, 184, 0.58);
    padding: 0.7rem 0;
  }

  .reason-list strong {
    font-family: var(--font-serif);
  }

  .intro-conclusion {
    border-left: 2px solid var(--accent);
    color: var(--ink) !important;
    font-weight: 700;
    padding-left: 0.85rem;
  }

  .acquisition-section {
    background: rgba(26, 26, 26, 0.018);
  }

  .acquisition-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  .pillar-card .badge {
    margin-bottom: 0.85rem;
  }

  .topic-directory {
    border-top: 1px solid var(--lead);
    margin-top: 2.5rem;
    padding-top: 1.5rem;
  }

  .topic-directory > h3 {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .topic-list {
    display: grid;
    gap: 0;
  }

  .topic-list > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(184, 184, 184, 0.55);
    padding: 0.9rem 0;
    text-decoration: none;
  }

  .topic-list > a:first-child {
    border-top: 0;
  }

  .topic-list strong,
  .topic-list small {
    display: block;
  }

  .topic-list small {
    color: var(--grey);
    font-size: 0.82rem;
    margin-top: 0.15rem;
  }

  @media (max-width: 767px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .reason-list li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .topic-list > a {
      align-items: flex-start;
    }
  }
</style>
