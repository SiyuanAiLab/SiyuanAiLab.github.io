---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import KnowledgeDirectory from '../../../components/KnowledgeDirectory.astro';
import CardTable from '../../../components/CardTable.astro';
import CategorySubnav from '../../../components/CategorySubnav.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const categories = ['toolkits', 'career', 'sources'] as const;
  return categories.map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params;

const categoryLabels: Record<string, string> = {
  toolkits: '工具配置与选型',
  career: '职业与能力',
  sources: '信源与标准',
};

const categoryDescs: Record<string, string> = {
  toolkits: '按真实用途组织工具判断、配置方法与选型参考。',
  career: '理解 AI 时代的能力变化，建立更有韧性的职业组合。',
  sources: '可信信息源、评估标准与筛选方法。',
};

const allCards = await getCollection('knowledge');

function getSlug(cardId: string): string {
  return cardId.replace(/.*\//, '').replace(/\.mdx?$/, '');
}

const categoryIntro = allCards.find((c) => c.data.category === category && getSlug(c.id) === 'index');
const IntroContent = categoryIntro ? (await render(categoryIntro)).Content : null;

const cards = allCards
  .filter(
    (c) =>
      c.data.category === category &&
      c.data.public &&
      !c.data.draft &&
      getSlug(c.id) !== 'index' &&
      (category !== 'toolkits' || Boolean(c.data.subcategory)),
  )
  .sort((a, b) => {
    const levelOrder = { '入门': 0, '进阶': 1, '深度': 2 };
    const levelDiff = levelOrder[a.data.level] - levelOrder[b.data.level];
    if (levelDiff !== 0) return levelDiff;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const sourceSubcategoryOrder = [
  '信源分级与框架',
  '官方文档与产品更新',
  '研究论文与预印本',
  '权威媒体与机构洞察',
  '深度播客与视频',
  'Newsletter 与策展者',
  '社交媒体账号',
];

function groupSourceCards(items: typeof cards) {
  const groups = new Map<string, typeof cards>();
  for (const item of items) {
    const groupName = item.data.subcategory ?? '其他';
    const groupItems = groups.get(groupName) ?? [];
    groupItems.push(item);
    groups.set(groupName, groupItems);
  }

  return [...sourceSubcategoryOrder, '其他']
    .map((title) => ({ title, cards: groups.get(title) ?? [] }))
    .filter((group) => group.cards.length > 0);
}

const toolkitGroupOrder = [
  'decision',
  'llm-text',
  'llm-image',
  'llm-video',
  'agent-framework',
  'code-agent',
  'knowledge-base',
  'ai-search',
  'productivity',
  'audio',
  'wearable',
  'health',
];

const toolkitGroupLabels: Record<string, string> = {
  decision: '选型决策',
  'llm-text': '大语言模型',
  'llm-image': '图像生成',
  'llm-video': '视频生成',
  'agent-framework': 'Agent 框架',
  'code-agent': '代码型 Agent',
  'knowledge-base': '知识库',
  'ai-search': 'AI 搜索',
  productivity: '效率创作',
  audio: '音频设备',
  wearable: '可穿戴设备',
  health: '健康设备',
  other: '其他',
};

const toolkitSubcategoryToGroup: Record<string, string> = {
  decision: 'decision',
  'llm-international': 'llm-text',
  'llm-china': 'llm-text',
  'llm-image': 'llm-image',
  'llm-video': 'llm-video',
  'agent-open-source': 'agent-framework',
  'agent-china': 'agent-framework',
  'agent-coding': 'code-agent',
  'knowledge-base-local': 'knowledge-base',
  'knowledge-base-cloud': 'knowledge-base',
  'ai-search-general': 'ai-search',
  'ai-search-chinese': 'ai-search',
  'productivity-video': 'productivity',
  'productivity-image': 'productivity',
  'productivity-audio': 'productivity',
  'productivity-presentation': 'productivity',
  'hardware-audio': 'audio',
  'hardware-wearable': 'wearable',
  'hardware-health': 'health',
};

function groupToolkitCards(items: typeof cards) {
  const groups = new Map<string, typeof cards>();
  for (const item of items) {
    const groupName = toolkitSubcategoryToGroup[item.data.subcategory ?? ''] ?? 'other';
    const groupItems = groups.get(groupName) ?? [];
    groupItems.push(item);
    groups.set(groupName, groupItems);
  }

  return [...toolkitGroupOrder, 'other']
    .map((key) => ({ key, title: toolkitGroupLabels[key] ?? key, cards: groups.get(key) ?? [] }))
    .filter((group) => group.cards.length > 0);
}

const shouldGroupSidebar = category === 'sources' || category === 'toolkits';
const sidebarGroups = shouldGroupSidebar
  ? category === 'sources'
    ? groupSourceCards(cards)
    : groupToolkitCards(cards)
  : [];

const categoryGroups = (shouldGroupSidebar
  ? sidebarGroups
  : [{ title: '全部词条', cards }]
).map((group, index) => ({
  ...group,
  id: `group-${index + 1}`,
}));

const subnavItems = categoryGroups.map((group) => ({
  id: group.id,
  title: group.title,
  count: group.cards.length,
}));

function toTableCard(entry: typeof cards[number]) {
  return {
    id: getSlug(entry.id),
    title: entry.data.title,
    title_en: '',
    summary: entry.data.description,
    tags: entry.data.tags,
    url: `/knowledge/${category}/${getSlug(entry.id)}/`,
  };
}
---

<Layout title={`${categoryLabels[category]} - AI·外脑`} description={`思行致远 AI·外脑：${categoryDescs[category]}`}>
  <Header />

  <main class="site-main category-page">
    <div class="container two-pane">
      <KnowledgeDirectory activeSection={category}>
        <nav class="category-tree" aria-label={`${categoryLabels[category]}子目录`}>
          <a class="category-tree-title" href={`/knowledge/${category}/`}>{categoryLabels[category]}子目录</a>
          {categoryGroups.map((group) => (
            <details open={category === 'career'}>
              <summary>{group.title}（{group.cards.length}）</summary>
              <ul>
                {group.cards.map((card) => (
                  <li><a href={`/knowledge/${category}/${getSlug(card.id)}/`}>{card.data.title}</a></li>
                ))}
              </ul>
            </details>
          ))}
        </nav>
      </KnowledgeDirectory>

      <section class="main-content knowledge-main">
        {cards.length > 0 ? (
          <div class="category-overview">
            <p class="kicker">{categoryLabels[category]}</p>
            <h1>{categoryLabels[category]}</h1>
            {IntroContent ? (
              <div class="category-intro">
                <IntroContent />
              </div>
            ) : (
              <p class="desc">{categoryDescs[category]}</p>
            )}
            <p class="card-count">共 {cards.length} 张卡片</p>

            <a class="install-guide" href="/knowledge/install/">
              <span>如何下载这份 AI·外脑</span>
              <strong>查看获取与安装说明</strong>
            </a>

            <CategorySubnav items={subnavItems} />

            {categoryGroups.map((group) => (
              <section class="knowledge-group" id={group.id}>
                <div class="knowledge-group-head">
                  <h2>{group.title}</h2>
                  <span>{group.cards.length} 张</span>
                </div>
                <CardTable
                  cards={group.cards.map(toTableCard)}
                  showId={false}
                  label={`${group.title}词条列表`}
                  urlBuilder={(card) => card.url}
                />
              </section>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>该分类正在整理中</h2>
            <p>首批卡片正在审核和结构化处理中，完成后会自动出现在这里。</p>
            <a href="/knowledge/" class="btn">返回 AI·外脑入口</a>
          </div>
        )}
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .category-page {
    padding: clamp(32px, 5vw, 56px) 0;
  }

  .two-pane {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 80px;
    border-right: 1px solid var(--lead);
    padding-right: 24px;
  }

  .sidebar-header .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.75rem;
  }

  .sidebar-header h2 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .sidebar-desc {
    color: var(--grey);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .other-cats {
    margin-bottom: 1.5rem;
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }

  .other-cats summary {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    color: var(--grey);
  }

  .other-cats ul {
    list-style: none;
    padding: 0.75rem 0 0 0;
    margin: 0;
  }

  .other-cats li {
    padding: 0.35rem 0;
  }

  .other-cats a {
    font-size: 0.9rem;
    text-decoration: none;
  }

  .other-cats a:hover {
    color: var(--accent);
  }

  .card-nav h3 {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--grey);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card-nav li {
    margin-bottom: 0.5rem;
  }

  .card-groups {
    display: grid;
    gap: 0.9rem;
  }

  .card-group {
    border-bottom: 1px solid rgba(184, 184, 184, 0.35);
    padding-bottom: 0.75rem;
  }

  .card-group:last-child {
    border-bottom: none;
  }

  .card-group summary {
    cursor: pointer;
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    margin-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .card-link {
    display: block;
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .card-link:hover {
    border-color: var(--lead);
    background: rgba(26, 26, 26, 0.02);
  }

  .card-link-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .card-link-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .card-link-meta .curated {
    font-size: 0.72rem;
    color: var(--grey);
  }

  .main-content {
    min-width: 0;
  }

  .category-overview .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.75rem;
  }

  .category-overview h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin-bottom: 0.75rem;
  }

  .category-overview .desc {
    color: var(--grey);
    margin-bottom: 0.5rem;
  }

  .category-intro {
    color: var(--grey);
    max-width: var(--content-max);
    margin-bottom: 1rem;
  }

  .category-intro :global(h1) {
    display: none;
  }

  .category-intro :global(h2) {
    color: var(--ink);
    font-size: 1.15rem;
    margin: 1.25rem 0 0.45rem;
  }

  .category-intro :global(p),
  .category-intro :global(li) {
    font-size: 0.96rem;
  }

  .category-intro :global(ul) {
    padding-left: 1.15rem;
    margin: 0.5rem 0 0;
  }

  .card-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--grey);
    margin-bottom: 1.25rem;
  }

  .install-guide {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--lead);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    text-decoration: none;
  }

  .install-guide span,
  .install-guide strong {
    display: block;
  }

  .install-guide strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-align: right;
  }

  .card-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  .card-list-item {
    display: block;
    text-decoration: none;
    background: rgba(26, 26, 26, 0.02);
    border: 1px solid var(--lead);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card-list-item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-paper);
    transform: translateY(-2px);
  }

  .card-list-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .card-list-item p {
    color: var(--grey);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .level-tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    border-radius: var(--radius);
  }

  .curated {
    font-size: 0.72rem;
    color: var(--grey);
    font-family: var(--font-mono);
  }

  .empty-state {
    text-align: center;
    padding: clamp(48px, 10vw, 96px) 0;
  }

  .empty-state h2 {
    margin-bottom: 1rem;
  }

  .empty-state p {
    color: var(--grey);
    margin-bottom: 1.5rem;
  }

  .empty {
    color: var(--grey);
    font-size: 0.9rem;
  }

  @media (max-width: 980px) {
    .two-pane {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--lead);
      padding-right: 0;
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .card-nav > ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .card-group ul {
      display: grid;
      gap: 0.5rem;
    }

    .card-nav li {
      margin-bottom: 0;
    }

    .card-link {
      padding: 0.4rem 0.6rem;
    }
  }

  @media (max-width: 600px) {
    .install-guide {
      align-items: flex-start;
      flex-direction: column;
    }

    .install-guide strong {
      text-align: left;
    }
  }
</style>
