---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "提案策划管线 Skill 已迁移";
const pageDescription = "提案策划管线 Skill 已迁移到思远 AI Lab 实验室的 Skill 展厅。";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="site-main moved-page">
    <section class="moved-hero" aria-labelledby="moved-title">
      <div class="container moved-panel">
        <p class="kicker">页面已迁移</p>
        <h1 id="moved-title">提案策划管线 Skill 已放入实验室</h1>
        <p>
          独立站 1.0 已改为“AI 时代人物养成系统”的展厅结构。提案策划管线不再作为单独导购页展示，而是放在 Skill 展厅中。
        </p>
        <div class="moved-actions">
          <a href="/lab/skills/proposal-planning/" class="btn">查看新的 Skill 详情</a>
          <a href="/lab/skills/" class="btn btn-outline">进入 Skill 展厅</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .moved-hero {
    padding: clamp(72px, 10vw, 128px) 0;
  }

  .moved-panel {
    max-width: 860px;
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 1.2rem;
  }

  .moved-panel h1 {
    font-size: clamp(2.1rem, 5vw, 4.2rem);
  }

  .moved-panel p {
    color: var(--grey);
    font-size: clamp(1.04rem, 1.7vw, 1.22rem);
  }

  .moved-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 600px) {
    .moved-actions {
      display: block;
    }

    .moved-actions .btn {
      margin-bottom: 0.8rem;
    }
  }
</style>
