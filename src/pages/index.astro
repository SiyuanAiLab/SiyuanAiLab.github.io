---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHubRoutes from '../components/HomeHubRoutes.astro';
import HomeKnowledgePreview from '../components/HomeKnowledgePreview.astro';
import HomeLabPreview from '../components/HomeLabPreview.astro';
import { knowledgePillars } from '../data/knowledge-directory';
import knowledgeData from '../data/knowledge-cards.json';
import workflowData from '../data/workflow-cards.json';
import '../styles/home.css';

const pageTitle = '首页';
const pageDescription = '纸间拾光，记录一个非技术背景的人如何把 AI 放进真实工作流。判断比工具更重要，机制比灵感更可靠。';

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((article) => article.data.public && !article.data.draft && article.data.auditStatus === 'approved')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const articleCount = publishedArticles.length;
const latestArticles = publishedArticles.slice(0, 3);
const knowledgeCardCount = knowledgeData.cards.length;
const workflowCount = workflowData.cards.length;
const knowledgeAssetCount = knowledgeCardCount + workflowCount;

const hubRoutes = [
  {
    number: '01',
    name: 'AI·LAB',
    value: '接受变化，创建、创造与 AI 协同的工作机制。',
    evidence: '个人操作系统 / Skill 展厅 / 项目与趣味实验',
    meta: '3 个展区',
    cta: '进入 AI·LAB',
    href: '/lab/',
  },
  {
    number: '02',
    name: 'AI·观',
    value: '我在观察世界，AI 在观察我。',
    evidence: latestArticles[0]?.data.title ?? '从真实问题开始建立判断',
    meta: `${articleCount} 篇公开文章`,
    cta: '查看观察日记',
    href: '/articles/',
  },
  {
    number: '03',
    name: 'AI·外脑',
    value: '给人和 Agent 共用的第二大脑。概念、方法与工作流可以搜索、引用和复用。',
    evidence: `${knowledgeCardCount} 个核心概念 · ${workflowCount} 个工作流`,
    meta: `${knowledgeAssetCount} 项知识资产`,
    cta: '探索 AI·外脑',
    href: '/knowledge/',
  },
];

const proofPoints = [
  { value: '16 年', label: '营销实战' },
  { value: '10 年', label: '管理经验' },
  { value: String(articleCount), label: '公开文章' },
  { value: String(knowledgeAssetCount), label: '结构化知识资产' },
];

const labZones = [
  {
    name: '个人操作系统',
    description: '看记忆、协作、知识、经营与日度推进如何连成一套系统。',
    href: '/lab/personal-os/',
  },
  {
    name: 'Skill 展厅',
    description: '查看从真实工作中提炼出的可复用判断与执行框架。',
    href: '/lab/skills/',
  },
  {
    name: '项目与趣味展厅',
    description: '记录半成品、玩具和仍在生长中的个人实验。',
    href: '/lab/projects/',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="site-main home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="container home-hero" data-reveal>
        <p class="home-brand">纸间拾光</p>
        <div class="home-title-wrap">
          <h1 id="home-title">
            <span class="home-title-line">判断比</span>
            <span class="home-title-line"><b>工具</b>更重要</span>
          </h1>
          <p class="home-editor-note">先有判断，才有真正有价值的 AI 工作流。</p>
        </div>
        <p class="home-lede">记录我如何把 AI 放进真实工作流，而不是停留在工具收集。</p>
      </div>

      <div class="container" data-reveal>
        <HomeHubRoutes routes={hubRoutes} />
      </div>
    </section>

    <section class="home-proof" aria-label="可信事实" data-reveal>
      <div class="container home-proof-grid">
        <p>把复杂世界整理成可执行的下一步。</p>
        {proofPoints.map((point) => (
          <div>
            <strong>{point.value}</strong>
            <span>{point.label}</span>
          </div>
        ))}
      </div>
    </section>

    <HomeLabPreview zones={labZones} />

    <section class="home-section home-articles" aria-labelledby="articles-preview-title" data-reveal>
      <div class="container home-articles-grid">
        <div class="home-section-copy">
          <p class="home-kicker">AI·观</p>
          <h2 id="articles-preview-title"><span>我在观察世界，</span><span>AI 在观察我。</span></h2>
          <a class="home-text-link" href="/articles/">查看我们的观察日记 <span aria-hidden="true">→</span></a>
        </div>

        <div class="home-article-list">
          {latestArticles.map((article, index) => (
            <a href={`/articles/${article.id.replace(/\.mdx?$/, '')}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p>{article.data.seriesTitle ?? article.data.category}</p>
                <h3>{article.data.title}</h3>
                <small>{article.data.description}</small>
              </div>
              <time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toISOString().slice(0, 10)}</time>
            </a>
          ))}
        </div>
      </div>
    </section>

    <HomeKnowledgePreview
      pillars={knowledgePillars}
      knowledgeCardCount={knowledgeCardCount}
      workflowCount={workflowCount}
    />

    <section class="home-contact" aria-labelledby="home-contact-title" data-reveal>
      <div class="container home-contact-grid">
        <h2 id="home-contact-title">如果这些记录对你有用，继续关注更新。</h2>
        <p>公众号发布长文和阶段进展，联系页保留公开交流入口。</p>
        <a class="btn" href="/contact/">关注与联系</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const revealItems = document.querySelectorAll('[data-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('home-reveal-ready');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px 10% 0px' });

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
