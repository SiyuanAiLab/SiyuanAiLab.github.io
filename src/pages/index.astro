---
const sections = [
  { id: 'curation', title: '认知策展', principle: '输入自己选', description: '掌控输入，就是掌控判断的原料。我读什么、信什么、标记什么，判断源公开可查。' },
  { id: 'decisions', title: '决策主权', principle: '判断自己做', description: '判断不外包。每一次选择，连同依据一起留下。' },
  { id: 'work', title: '作品集', principle: '产出自己持有', description: '工具自己造，服务于我自己，也有可能服务于你。' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="思远 AI Labs —— AI 赋能的掌控呈现。输入自己选、判断自己做、产出自己持有。" />
    <title>思远 AI Labs</title>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header>
      <a class="wordmark" href="/" aria-label="思远 AI Labs，首页">思远 AI Labs</a>
      <nav aria-label="栏目导航">{sections.map(section => <a href={section.id === 'curation' ? '/curation/' : `#${section.id}`}>{section.title}</a>)}</nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="title">
        <img class="hero-art" src="/images/homepage-thinking-studio.png" width="2120" height="742" alt="" fetchpriority="high" />
        <blockquote class="epigraph">
          <h1 id="title">那是最美好的时代，那是最糟糕的时代；那是智慧的年头，也是愚昧的年头。</h1>
          <p class="quote-original" lang="en">"It was the best of times, it was the worst of times, it was the age of wisdom, it was the age of foolishness."</p>
        </blockquote>
        <p class="quote-attribution">—— 查尔斯·狄更斯《双城记》</p>
        <div class="opening">
          <p>最好——AI 第一次让一个人可以掌控从信息到产出的全链路。</p>
          <p>最坏——你不掌控，就被掌控：输入被平台喂，判断被算法代劳，产出存在别人的服务器上。</p>
          <p>这个站，是 AI 赋能我的掌控呈现。</p>
        </div>
        <a class="browse" href="#directory">浏览三个栏目</a>
      </section>
      <section id="directory" class="directory" aria-labelledby="directory-title">
        <h2 id="directory-title">从输入，到判断，再到作品。</h2>
        <div class="columns">
          {sections.map(section => <article id={section.id} class="column" tabindex="-1">
            <p class="principle">{section.principle}</p>
            <h3>{section.title}</h3>
            <p class="description">{section.description}</p>
            {section.id === 'curation' ? <a class="section-link" href="/curation/">阅读日报 <span aria-hidden="true">→</span></a> : <details>
              <summary>查看栏目</summary>
              <p class="empty">内容整理中。</p>
            </details>}
          </article>)}
        </div>
      </section>
      <p class="closing">慢慢积累，认真留下。</p>
    </main>
    <footer>
      <p>思远 AI Labs</p>
      <div class="legal">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">浙ICP备2026063003号</a>
        <a href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=33021102001302" target="_blank" rel="noopener noreferrer">浙公网安备33021102001302号</a>
        <a href="https://github.com/SiyuanAiLab" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; font-family: -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif; color:#161616; background:#fff; font-synthesis:none; scroll-behavior:smooth; }
  * { box-sizing:border-box; }
  body { margin:0; min-height:100dvh; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration:none; }
  :focus-visible { outline:2px solid #222; outline-offset:5px; border-radius:4px; }
  header { max-width:1440px; margin-inline:auto; min-height:76px; padding:22px 40px; display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .wordmark { font-size:21px; font-weight:750; letter-spacing:-.04em; white-space:nowrap; }
  .wordmark span { margin-left:12px; color:#666; font-weight:400; font-size:13px; letter-spacing:0; }
  nav { display:flex; gap:28px; font-size:14px; }
  nav a { padding:6px 0; }
  nav a:hover, .legal a:hover { text-decoration:underline; text-underline-offset:5px; }
  main { display:block; }
  .hero { text-align:center; padding:34px 24px 92px; }
  .hero-art { display:block; width:min(460px,85%); height:auto; margin:0 auto 25px; }
  .epigraph { max-width:960px; margin:0 auto; }
  h1 { margin:0; font-size:clamp(30px,3.2vw,44px); line-height:1.5; font-weight:750; letter-spacing:-.035em; text-wrap:balance; }
  .quote-original { max-width:690px; margin:20px auto 0; font-size:15px; line-height:1.7; color:#6b6b6b; text-wrap:balance; }
  .quote-attribution { margin:12px 0 0; font-size:13px; line-height:1.8; color:#6b6b6b; }
  .opening { max-width:760px; font-size:18px; line-height:1.85; margin:36px auto 27px; color:#484848; text-wrap:pretty; }
  .opening p { margin:0; }
  .opening p + p { margin-top:12px; }
  .opening p:last-child { margin-top:24px; }
  .browse { display:inline-flex; align-items:center; justify-content:center; min-height:46px; border:1px solid #161616; border-radius:7px; background:#161616; color:#fff; font-size:15px; font-weight:600; padding:12px 24px; transition:background .16s ease; }
  .browse:hover { background:#393939; }
  .directory, footer { width:calc(100% - 80px); max-width:1080px; margin-inline:auto; }
  .directory { scroll-margin-top:32px; }
  h2 { margin:0 0 30px; text-align:center; font-size:32px; line-height:1.4; letter-spacing:-.035em; font-weight:700; }
  .columns { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); background:#f7f7f6; border:1px solid #ececea; border-radius:14px; overflow:hidden; }
  .column { padding:32px; scroll-margin-top:40px; }
  .column + .column { border-left:1px solid #e4e4e1; }
  .principle { font-size:13px; color:#646461; margin:0 0 13px; }
  h3 { font-size:25px; letter-spacing:-.025em; line-height:1.4; margin:0 0 13px; }
  .description { margin:0 0 25px; font-size:15px; line-height:1.8; color:#535350; min-height:81px; }
  details { font-size:14px; }
  summary { cursor:pointer; padding:5px 0; width:fit-content; text-decoration:underline; text-underline-offset:4px; }
  summary:hover, .section-link:hover { color:#666; }
  .section-link { display:inline-block; padding:5px 0; font-size:14px; text-decoration:underline; text-underline-offset:4px; }
  .empty { font-size:13px; line-height:1.8; color:#666; margin:12px 0 0; }
  .closing { margin:54px 24px 66px; text-align:center; font-size:15px; color:#666; }
  footer { border-top:1px solid #e8e8e6; padding:24px 0 28px; display:flex; gap:16px; justify-content:space-between; align-items:start; color:#666; }
  footer p { margin:0; font-size:12px; line-height:1.8; }
  .legal { display:flex; flex-wrap:wrap; gap:6px 15px; font-size:11px; line-height:1.8; }
  .skip { position:absolute; left:16px; top:-100px; padding:10px; background:#fff; z-index:2; }
  .skip:focus { top:8px; }
  @media (prefers-reduced-motion:no-preference) {
    .hero .epigraph,.hero .quote-attribution,.hero .opening,.hero .browse { animation:arrive .55s both; }
    .hero .opening { animation-delay:.07s; }
    .hero .browse { animation-delay:.14s; }
    @keyframes arrive { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
  }
  @media (max-width:800px) {
    header { padding:20px 24px; }
    .wordmark span { display:none; }
    nav { gap:22px; }
    .hero { padding-top:32px; padding-bottom:70px; }
    .directory,footer { width:calc(100% - 48px); }
    .column { padding:25px 21px; }
    h3 { font-size:22px; }
    .description { min-height:108px; font-size:14px; }
    footer { flex-direction:column; }
  }
  @media (max-width:600px) {
    header { padding:18px 20px; gap:12px; min-height:65px; }
    .wordmark { font-size:18px; }
    nav { gap:14px; font-size:12px; }
    .hero { padding:36px 20px 65px; }
    .hero-art { width:min(340px,100%); margin-bottom:28px; }
    h1 { font-size:clamp(27px,7.2vw,36px); line-height:1.55; }
    .quote-original { font-size:13px; margin-top:18px; }
    .quote-attribution { font-size:12px; }
    .opening { font-size:15px; margin-top:28px; text-align:left; }
    .opening p:last-child { margin-top:22px; }
    .directory,footer { width:calc(100% - 40px); }
    h2 { font-size:23px; margin-bottom:24px; }
    .columns { grid-template-columns:1fr; }
    .column { padding:26px; }
    .column + .column { border-left:0; border-top:1px solid #e4e4e1; }
    .description { min-height:0; margin-bottom:17px; }
    .closing { margin:38px 20px 45px; }
  }
  @media (prefers-reduced-motion:reduce) { :root { scroll-behavior:auto; } * { transition:none !important; } }
</style>
