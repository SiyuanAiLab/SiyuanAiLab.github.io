---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import knowledgeData from '../data/knowledge-cards.json';
import workflowData from '../data/workflow-cards.json';

const pageTitle = "首页";
const pageDescription = "思远 AI Lab，帮非技术创业者把 AI 放进真实工作流。判断比工具更重要，机制比灵感更可靠。";

const allArticles = await getCollection('articles');
const latestArticles = allArticles
  .filter((article) => article.data.public && !article.data.draft && article.data.auditStatus === 'approved')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const articleResults = latestArticles.slice(0, 2).map((article) => ({
  type: '文章',
  title: article.data.title,
  desc: article.data.description,
  meta: article.data.pubDate.toISOString().slice(0, 10),
  href: `/articles/${article.id.replace(/\.mdx?$/, '')}`,
}));

const knowledgeResults = [
  knowledgeData.cards.find((card) => card.slug === 'ai-agent'),
  knowledgeData.cards.find((card) => card.slug === 'agentic-workflow'),
].filter(Boolean).map((card) => ({
  type: '知识卡片',
  title: card.title,
  desc: card.summary,
  meta: card.column === 'concepts' ? '概念' : '工作流',
  href: `/knowledge/ai-core/${card.column}/${card.slug}/`,
}));

const skillResults = workflowData.cards
  .filter((card) => card.title.toLowerCase().includes('agent'))
  .slice(0, 2)
  .map((card) => ({
    type: 'Skill',
    title: card.title,
    desc: card.summary,
    meta: card.category === 'execution' ? '进阶' : '中级',
    href: `/knowledge/workflows/${card.category}/${card.subcategory}/${card.slug}/`,
  }));

const consoleGroups = [
  {
    title: '文章',
    meta: `${articleResults.length} 条判断`,
    more: `查看全部 ${latestArticles.length} 篇`,
    href: '/articles',
    items: articleResults,
  },
  {
    title: '知识卡片',
    meta: `${knowledgeResults.length} 张卡片`,
    more: `查看全部 ${knowledgeResults.length} 张`,
    href: '/knowledge',
    items: knowledgeResults,
  },
  {
    title: 'Skill',
    meta: `${skillResults.length} 个工作流`,
    more: `查看全部 ${skillResults.length} 个`,
    href: '/lab/skills/',
    items: skillResults,
  },
];

const searchItems = [...articleResults, ...knowledgeResults, ...skillResults];

const routeRows = [
  {
    number: '01',
    title: '文章',
    desc: '跨领域的观察与拆解，帮你建立更高质量的判断。',
    href: '/articles',
    cta: '进入文章',
  },
  {
    number: '02',
    title: '知识库',
    desc: '概念、方法、框架、工作流，可搜索、可引用、可使用。',
    href: '/knowledge',
    cta: '探索知识库',
  },
  {
    number: '03',
    title: '实验室',
    desc: '个人操作系统、Skill 和正在筹备的 AI 项目，持续进化中。',
    href: '/lab/',
    cta: '进入实验室',
  },
];

const proofPoints = [
  { value: '12 年', label: '营销实战' },
  { value: '10 年', label: '管理经验' },
  { value: 'AI 公司', label: '筹备期' },
  { value: '可搜索', label: '知识库' },
];

const productRoutes = [
  {
    title: '个人操作系统',
    desc: '用 Obsidian、Hermes 和 Tamarin 搭起个人 AI 工作底座。',
    href: '/lab/personal-os/',
  },
  {
    title: 'Skill 展厅',
    desc: '把真实工作流拆成可复用的判断与执行框架。',
    href: '/lab/skills/',
  },
  {
    title: '联系合作',
    desc: '有真实业务场景时，从问题和边界开始聊。',
    href: '/contact',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="site-main judgment-home">
    <section class="judgment-hero" aria-labelledby="hero-title">
      <div class="hero-shell">
        <div class="hero-thesis" data-reveal>
          <p class="kicker">思远 AI Lab</p>
          <h1 id="hero-title">
            <span class="headline-line">判断比</span>
            <span class="headline-line headline-line-wide">
              <span class="accent-circle">工具</span><span>更重要</span>
            </span>
          </h1>
          <p class="editor-note" aria-label="编辑批注">先有判断，才有真正有价值的 AI 工作流。</p>
          <p class="hero-lede">
            帮非技术创业者把 AI 放进真实工作流，而不是停留在工具收集。
          </p>
          <p class="hero-note">
            先看清问题，再设计机制。AI 负责执行，人负责判断、品味和承担后果。
          </p>

          <div class="hero-actions" aria-label="首屏入口">
            <a href="/articles" class="btn btn-accent">开始阅读 <span aria-hidden="true">→</span></a>
            <a href="/knowledge" class="btn btn-outline">搜索知识库 <span aria-hidden="true">→</span></a>
          </div>

          <div class="topic-line" aria-label="核心主题">
            <span>策略判断</span>
            <span>工作流设计</span>
            <span>内容资产</span>
            <span>个人操作系统</span>
          </div>
        </div>

        <aside class="console-panel" aria-labelledby="console-title" data-reveal>
          <div class="console-header">
            <p class="console-kicker" id="console-title">Knowledge Console</p>
            <span>SEARCH</span>
          </div>

          <div class="console-search">
            <label for="home-console-search">搜索站内内容</label>
            <div class="console-input-row">
              <span aria-hidden="true">&gt;</span>
              <input
                id="home-console-search"
                type="search"
                value="Agent 工作流"
                autocomplete="off"
                data-home-search
              />
              <a href="/knowledge/?q=Agent%20%E5%B7%A5%E4%BD%9C%E6%B5%81" aria-label="打开知识库搜索">⌕</a>
            </div>
          </div>

          <div class="console-meta">
            <span>3 类内容</span>
            <span>按相关度排序</span>
          </div>

          <div class="console-results" data-console-results>
            {consoleGroups.map((group) => (
              <section class="result-group" aria-labelledby={`group-${group.title}`}>
                <div class="result-group-head">
                  <h2 id={`group-${group.title}`}>{group.title}</h2>
                  <span>{group.meta}</span>
                </div>
                <div class="result-list">
                  {group.items.map((item) => (
                    <a href={item.href} class="result-row">
                      <strong>{item.title}</strong>
                      <span>{item.meta}</span>
                    </a>
                  ))}
                </div>
                <a class="group-more" href={group.href}>{group.more}</a>
              </section>
            ))}
          </div>

          <p class="console-end">END OF RESULTS</p>
          <script type="application/json" data-home-search-index set:html={JSON.stringify(searchItems)} />
        </aside>
      </div>

      <div class="route-board" aria-label="站点路径" data-reveal>
        <div class="route-intro">
          <span>Next Routes</span>
          <p>把首屏的判断，继续落到可以阅读、搜索和探索的三个入口。</p>
        </div>

        <div class="route-list">
          {routeRows.map((route) => (
            <a class="route-row" href={route.href}>
              <span class="route-number">{route.number}</span>
              <strong>{route.title}</strong>
              <span>{route.desc}</span>
              <em>{route.cta}</em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="可信事实" data-reveal>
      <div class="proof-intro">
        <span>关于思远</span>
      </div>
      {proofPoints.map((point) => (
        <div class="proof-cell">
          <strong>{point.value}</strong>
          <span>{point.label}</span>
        </div>
      ))}
      <p class="proof-note">
        把复杂世界整理成可执行的下一步。
      </p>
    </section>

    <section class="section section-latest" aria-labelledby="latest-title">
      <div class="container latest-grid">
        <div class="section-copy" data-reveal>
          <p class="kicker">判断文章</p>
          <h2 id="latest-title">先读判断，再选工具。</h2>
          <p>
            文章负责解释为什么这样做。它们不是库存，而是把真实判断、产品过程和 AI 工作流沉淀成长期资产。
          </p>
          <a href="/articles" class="text-link">查看全部文章</a>
        </div>

        <div class="latest-list" data-reveal>
          {latestArticles.map((article, index) => (
            <a class="latest-row" href={`/articles/${article.id.replace(/\.mdx?$/, '')}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p>{article.data.seriesTitle ?? article.data.category}</p>
                <h3>{article.data.title}</h3>
                <small>{article.data.description}</small>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-products" aria-labelledby="products-title">
      <div class="container">
        <div class="section-copy narrow" data-reveal>
          <p class="kicker">实验室入口</p>
          <h2 id="products-title">不卖工具，设计机制。</h2>
          <p>
            实验室承接更具体的系统和装备：个人操作系统、Skill 展厅，以及真实业务场景里的合作入口。
          </p>
        </div>

        <div class="product-route-grid" data-reveal>
          {productRoutes.map((route) => (
            <a class="product-route" href={route.href}>
              <h3>{route.title}</h3>
              <p>{route.desc}</p>
              <span>查看入口</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const input = document.querySelector('[data-home-search]');
  const results = document.querySelector('[data-console-results]');
  const indexNode = document.querySelector('[data-home-search-index]');
  const items = JSON.parse(indexNode?.textContent || '[]');

  const normalize = (value) => String(value || '').toLowerCase().trim();
  const groupedFallback = results?.innerHTML || '';

  const renderSearch = (query) => {
    if (!results) return;
    const needle = normalize(query);
    if (!needle || needle === normalize('Agent 工作流')) {
      results.innerHTML = groupedFallback;
      return;
    }

    const matches = items
      .filter((item) => normalize(`${item.type} ${item.title} ${item.desc}`).includes(needle))
      .slice(0, 6);

    if (!matches.length) {
      results.innerHTML = '<div class="empty-console">没有找到匹配内容。可以换成“Agent”“工作流”“系统”。</div>';
      return;
    }

    results.innerHTML = `
      <section class="result-group">
        <div class="result-group-head">
          <h2>搜索结果</h2>
          <span>${matches.length} 条</span>
        </div>
        <div class="result-list">
          ${matches.map((item) => `
            <a href="${item.href}" class="result-row">
              <strong>${item.title}</strong>
              <span>${item.desc}</span>
            </a>
          `).join('')}
        </div>
      </section>
    `;
  };

  input?.addEventListener('input', (event) => {
    renderSearch(event.target.value);
  });

  const revealItems = document.querySelectorAll('[data-reveal]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.16 });

  revealItems.forEach((item) => observer.observe(item));
</script>

<style>
  .judgment-home {
    overflow: hidden;
  }

  .judgment-hero {
    border-bottom: 1px solid var(--ink);
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(360px, 0.82fr);
    --console-inset: clamp(36px, 3.4vw, 48px);
    --hero-gutter: clamp(36px, 4vw, 60px);
    margin: 0 auto;
    max-width: var(--page-max);
    padding: 0 clamp(20px, 4vw, 40px);
  }

  .hero-thesis,
  .console-panel {
    padding-bottom: 42px;
    padding-top: 72px;
  }

  .hero-thesis {
    border-right: 1px solid var(--lead);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 610px;
    padding-left: 0;
    padding-right: var(--hero-gutter);
    position: relative;
  }

  .kicker,
  .console-kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .hero-thesis h1 {
    font-size: clamp(4.7rem, 6.2vw, 5.9rem);
    line-height: 1.02;
    margin: 0 0 1.4rem;
    max-width: 620px;
  }

  .headline-line {
    display: block;
    white-space: nowrap;
  }

  .headline-line-wide {
    align-items: baseline;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.06em;
    white-space: nowrap;
  }

  .accent-circle {
    display: inline-block;
    position: relative;
  }

  .accent-circle::after {
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    content: "";
    height: 0.92em;
    left: -0.16em;
    position: absolute;
    top: 0.06em;
    transform: rotate(-4deg);
    width: 1.92em;
    z-index: -1;
  }

  .editor-note {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.7;
    margin: -0.3rem 0 1.15rem;
    max-width: 260px;
    position: absolute;
    right: 0;
    top: 84px;
    transform: rotate(-7deg);
  }

  .editor-note::after {
    border-bottom: 1.5px solid var(--accent);
    border-radius: 50%;
    content: "";
    display: block;
    height: 16px;
    margin-top: 0.2rem;
    transform: rotate(-5deg);
    width: 150px;
  }

  .hero-lede {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.24rem;
    line-height: 1.7;
    max-width: 590px;
  }

  .hero-note {
    color: var(--grey);
    max-width: 580px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .hero-actions .btn {
    min-width: 190px;
  }

  .hero-actions .btn span {
    margin-left: 0.9rem;
  }

  .btn-accent {
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-accent:hover {
    background: var(--ink);
    border-color: var(--ink);
  }

  .text-link {
    border-bottom: 1px solid var(--accent);
    display: inline-block;
    font-weight: 700;
    margin-top: 0;
    text-decoration: none;
  }

  .topic-line {
    border-top: 1px solid var(--lead);
    color: var(--grey);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    gap: 0.85rem 1.1rem;
    margin-top: 1.55rem;
    padding-top: 1rem;
  }

  .topic-line span + span::before {
    color: var(--lead);
    content: "·";
    margin-right: 1.1rem;
  }

  .console-panel {
    background: rgba(245, 241, 233, 0.72);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: var(--console-inset);
    padding-right: 0;
    padding-top: 46px;
    position: relative;
  }

  .console-header,
  .console-meta,
  .result-group-head {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .console-header {
    border-bottom: 1px dotted var(--lead);
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin-bottom: 1rem;
    padding-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .console-header p {
    margin: 0;
  }

  .console-search label {
    color: var(--grey);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin-bottom: 0.4rem;
  }

  .console-input-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 56px;
  }

  .console-input-row span,
  .console-input-row input,
  .console-input-row a {
    background: rgba(245, 241, 233, 0.96);
    border: 2px solid var(--ink);
    min-height: 58px;
  }

  .console-input-row span,
  .console-input-row a {
    align-items: center;
    display: flex;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    justify-content: center;
  }

  .console-input-row span {
    border-right: 0;
  }

  .console-input-row input {
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.28rem;
    padding: 0.6rem 0.9rem;
  }

  .console-input-row input:focus {
    border-color: var(--accent);
    outline: none;
  }

  .console-input-row a {
    border-left: 0;
    color: var(--ink);
    font-weight: 700;
    padding: 0;
    text-decoration: none;
  }

  .console-input-row a:hover {
    color: var(--accent);
  }

  .console-meta {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin: 0.65rem 0 0.9rem;
  }

  .console-results {
    background: rgba(245, 241, 233, 0.58);
    border: 1px solid var(--lead);
    border-bottom: 0;
  }

  .result-group {
    border-bottom: 1px solid var(--lead);
    padding: 0.72rem 1.05rem 0.62rem;
    position: relative;
  }

  .result-group:first-child::before {
    background: var(--accent);
    content: "";
    left: -1px;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
  }

  .result-group-head {
    margin-bottom: 0.28rem;
  }

  .result-group h2 {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1rem;
    margin: 0;
  }

  .result-group-head span {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .result-list {
    display: grid;
    gap: 0;
  }

  .result-row {
    align-items: baseline;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 0.04rem 0;
    text-decoration: none;
  }

  .result-row strong {
    display: block;
    font-size: 0.94rem;
    line-height: 1.58;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-row span,
  .empty-console {
    color: var(--grey);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-row:hover strong {
    color: var(--accent);
  }

  .empty-console {
    border: 1px solid var(--lead);
    padding: 1rem;
  }

  .group-more {
    display: inline-block;
    font-size: 0.84rem;
    margin-top: 0.3rem;
    text-decoration: none;
  }

  .group-more::after {
    color: var(--accent);
    content: "→";
    margin-left: 0.55rem;
  }

  .console-end {
    color: var(--grey);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    margin: 0.8rem 0 0;
    text-align: right;
  }

  .route-board {
    border-top: 1px solid var(--lead);
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 1fr);
    margin: 0 auto;
    max-width: var(--page-max);
    padding: clamp(46px, 6vw, 76px) clamp(20px, 4vw, 40px);
  }

  .route-intro {
    max-width: 360px;
  }

  .route-intro span {
    color: var(--accent);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .route-intro p {
    color: var(--grey);
    font-family: var(--font-serif);
    font-size: 1.24rem;
    line-height: 1.75;
    margin: 0;
    max-width: 340px;
  }

  .route-list {
    border-top: 1px solid var(--ink);
  }

  .route-row {
    align-items: center;
    border-bottom: 1px solid var(--lead);
    color: var(--ink);
    display: grid;
    gap: 1rem;
    grid-template-columns: 56px 128px minmax(0, 1fr) 150px;
    min-height: 92px;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  .route-row:hover {
    background: rgba(192, 48, 48, 0.045);
    color: var(--ink);
  }

  .route-number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .route-row strong {
    font-family: var(--font-serif);
    font-size: 1.45rem;
  }

  .route-row span:not(.route-number) {
    color: var(--grey);
  }

  .route-row em {
    font-style: normal;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: flex-end;
